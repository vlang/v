// vtest vflags: -I
fn add(a int, b int) int {
	return a + b
}

fn main() {
	for i in 0 .. 10_000 {
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
		println(add(i, i))
	}
}
