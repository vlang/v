--- /dev/null
+++ b/ast_json_test.v
@@ -0,0 +1,163 @@
+module main
+
+import json2
+import os
+import strings
+
+fn test_recursive_json_types_preserve_discriminators_and_null_defaults() {
+	source := '{
+		"_type": "MapType",
+		"Key": {"_type": "Ident", "Name": "string"},
+		"Value": {
+			"_type": "MapType",
+			"Key": {"_type": "Ident", "Name": "int"},
+			"Value": {
+				"_type": "ArrayType",
+				"Len": null,
+				"Elt": {"_type": "Ident", "Name": "byte"}
+			}
+		}
+	}'
+	decoded := restore_ast_defaults(json2.decode[MapVal](source)!)
+	assert decoded is MapType
+	if decoded is MapType {
+		assert decoded.key is Ident
+		inner := decoded.val
+		assert inner is MapType
+		if inner is MapType {
+			assert inner.key is Ident
+			array := inner.val
+			assert array is ArrayType
+			if array is ArrayType {
+				assert array.len is InvalidExpr
+				kind := array.elt.node_type()
+				assert array.elt is Ident
+				assert kind == 'Ident'
+			}
+		}
+	}
+	// Omitted fields and ordinary V construction retain the same sentinel.
+	missing := restore_ast_defaults(json2.decode[Expr]('{"_type":"ArrayType"}')!)
+	assert missing is ArrayType
+	if missing is ArrayType {
+		assert missing.len is InvalidExpr
+		assert missing.elt is InvalidExpr
+	}
+	plain := ArrayType{}
+	assert plain.len is InvalidExpr
+	assert plain.elt is InvalidExpr
+	// MapVal historically starts with ArrayType, including for missing/null values.
+	for text in ['{"_type":"MapType"}', '{"_type":"MapType","Key":null,"Value":null}'] {
+		map_node := restore_ast_defaults(json2.decode[MapVal](text)!)
+		assert map_node is MapType
+		if map_node is MapType {
+			assert map_node.key is InvalidExpr
+			value := map_node.val
+			assert value is ArrayType
+			if value is ArrayType {
+				assert value.len is InvalidExpr
+				assert value.elt is InvalidExpr
+			}
+		}
+	}
+}
+
+fn test_recursive_json_statements_preserve_absent_nodes() {
+	source := '{
+		"_type": "IfStmt", "Init": null,
+		"Cond": {"_type": "Ident", "Name": "true"},
+		"Body": {"List": [{
+			"_type": "LabeledStmt", "Label": {"Name": "again"},
+			"Stmt": {
+				"_type": "ForStmt", "Init": null, "Cond": null, "Post": null,
+				"Body": {"List": []}
+			}
+		}]},
+		"Else": {
+			"_type": "IfStmt", "Init": null,
+			"Cond": {"_type": "Ident", "Name": "false"},
+			"Body": {"List": []}, "Else": null
+		}
+	}'
+	decoded := restore_ast_defaults(json2.decode[Stmt](source)!)
+	assert decoded is IfStmt
+	if decoded is IfStmt {
+		assert decoded.init.lhs.len == 0
+		label := decoded.body.list[0]
+		assert label is LabeledStmt
+		if label is LabeledStmt {
+			loop := label.stmt
+			assert loop is ForStmt
+			if loop is ForStmt {
+				assert loop.cond is InvalidExpr
+				assert loop.post is InvalidStmt
+			}
+		}
+		other := decoded.else_
+		assert other is IfStmt
+		if other is IfStmt {
+			assert other.else_ is InvalidStmt
+		}
+	}
+	missing := restore_ast_defaults(json2.decode[Stmt]('{"_type":"IfStmt"}')!)
+	assert missing is IfStmt
+	if missing is IfStmt {
+		assert missing.cond is InvalidExpr
+		assert missing.else_ is InvalidStmt
+	}
+}
+
+fn test_json_ast_generates_executable_v_without_go_tools() {
+	root := os.join_path(os.vtmp_dir(), 'go2v_json_ast_${os.getpid()}')
+	os.mkdir_all(root)!
+	defer { os.rmdir_all(root) or {} }
+	source := '{
+		"Name": {"Name": "main"},
+		"Decls": [{
+			"_type": "FuncDecl", "Doc": null, "Recv": null,
+			"Name": {"Name": "main"},
+			"Type": {"Params": {"List": []}, "Results": null},
+			"Body": {"List": [{
+				"_type": "AssignStmt", "Tok": ":=",
+				"Lhs": [{"_type": "Ident", "Name": "answer"}],
+				"Rhs": [{
+					"_type": "BinaryExpr", "Op": "+",
+					"X": {"_type": "BasicLit", "Kind": "INT", "Value": "1"},
+					"Y": {"_type": "ParenExpr", "X": {
+						"_type": "BinaryExpr", "Op": "*",
+						"X": {"_type": "BasicLit", "Kind": "INT", "Value": "2"},
+						"Y": {"_type": "BasicLit", "Kind": "INT", "Value": "3"}
+					}}
+				}]
+			}, {
+				"_type": "IfStmt", "Init": null,
+				"Cond": {
+					"_type": "BinaryExpr", "Op": "==",
+					"X": {"_type": "Ident", "Name": "answer"},
+					"Y": {"_type": "BasicLit", "Kind": "INT", "Value": "7"}
+				},
+				"Body": {"List": [{"_type": "ExprStmt", "X": {
+					"_type": "CallExpr", "Fun": {"_type": "Ident", "Name": "println"},
+					"Args": [{"_type": "Ident", "Name": "answer"}]
+				}}]},
+				"Else": null
+			}]}
+		}]
+	}'
+	json_path := os.join_path(root, 'input.json')
+	os.write_file(json_path, source)!
+	file := parse_go_ast(json_path)!
+	mut app := App{ sb: strings.new_builder(256), running_test: true }
+	output := app.generate_v_code(file)
+	v_path := os.join_path(root, 'main.v')
+	os.write_file(v_path, output)!
+	formatted := os.exec([@VEXE, 'fmt', '-w', v_path])
+	assert formatted.exit_code == 0, formatted.output
+	code := os.read_file(v_path)!
+	assert code.contains('answer := 1 + (2 * 3)'), code
+	assert code.contains('if answer == 7 {'), code
+	assert code.contains('println(answer)'), code
+	run := os.exec([@VEXE, '-new-compiler', '-no-retry-compilation', 'run', v_path])
+	assert run.exit_code == 0, run.output
+	assert run.output.trim_space() == '7'
+}
