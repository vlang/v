+
+// restore_ast_defaults gives decoded recursive edges the same sentinel values as
+// ordinary AST construction. json2 sets pointer fields to nil for explicit null.
+// The freshly decoded tree has not escaped, so its child storage can be updated.
+fn restore_ast_defaults[T](value T) T {
+	mut node := value
+	$if T is &Expr {
+		if isnil(node) {
+			return &Expr(InvalidExpr{})
+		}
+		unsafe { *node = restore_ast_defaults(*node) }
+	} $else $if T is &Stmt {
+		if isnil(node) {
+			return &Stmt(InvalidStmt{})
+		}
+		unsafe { *node = restore_ast_defaults(*node) }
+	} $else $if T is &MapVal {
+		if isnil(node) {
+			return &MapVal(ArrayType{})
+		}
+		unsafe { *node = restore_ast_defaults(*node) }
+	} $else $if T is $array_dynamic {
+		for i, child in node {
+			node[i] = restore_ast_defaults(child)
+		}
+	} $else $if T is $sumtype {
+		$for variant in T.variants {
+			if node is variant {
+				return T(restore_ast_defaults(node))
+			}
+		}
+	} $else $if T is $struct {
+		$for field in T.fields {
+			ptr := unsafe { &node.$(field.name) }
+			unsafe { *ptr = restore_ast_defaults(*ptr) }
+		}
+	}
+	return node
 }
 
 fn (e Expr) node_type() string {
