diff --git a/generator_test.v b/generator_test.v
new file mode 100644
index 0000000..02f0d7e
--- /dev/null
+++ b/generator_test.v
@@ -0,0 +1,44 @@
+module main
+
+import os
+import json2
+
+fn test_topic_titles_and_missing_titles() {
+	title := extract_title_from_markdown_topic('## A section\nBody') or {
+		panic('expected a section title')
+	}
+	assert title.title == 'A section'
+	assert title.level == 2
+	assert extract_title_from_markdown_topic('') == none
+	parts := split_source_by_topics('# V\n## Introduction\nText\n## Next\nMore', 2)
+	topics := extract_topics_from_markdown_parts(parts, false)
+	assert topics.map(it.title) == ['V', 'Introduction', 'Next']
+}
+
+fn test_mapping_serializes_titles_and_filenames_as_json() {
+	previous := os.getwd()
+	tmp := os.join_path(os.vtmp_dir(), 'docs_generator_mapping_${os.getpid()}')
+	os.mkdir_all(os.join_path(tmp, 'templates', 'assets', 'scripts'))!
+	os.mkdir_all(os.join_path(tmp, 'output', 'assets', 'scripts'))!
+	defer {
+		os.chdir(previous) or {}
+		os.rmdir_all(tmp) or {}
+	}
+	os.chdir(tmp)!
+	os.write_file('templates/assets/scripts/v-docs.js', 'const vdocs = {};\n')!
+	mut ctx := Context{
+		titles_to_fnames: {
+			'Quotes " and \\ and\nUnicode λ': 'quoted.html#part'
+		}
+		pages:            {
+			'quoted.html': 'quoted.html'
+		}
+	}
+	ctx.write_mapping()!
+	script := os.read_file('output/assets/scripts/v-docs.js')!
+	assert script.starts_with('const vdocs = {};\n')
+	titles_json := script.all_after('vdocs.titles_to_fnames = ').all_before(';\n\tvdocs.fnames = ')
+	pages_json := script.all_after('vdocs.fnames = ').trim_right(';')
+	assert json2.decode[map[string]string](titles_json)! == ctx.titles_to_fnames
+	assert json2.decode[map[string]string](pages_json)! == ctx.pages
+}
