diff --git a/log/log_test.v b/log/log_test.v
new file mode 100644
index 0000000..af8efc9
--- /dev/null
+++ b/log/log_test.v
@@ -0,0 +1,26 @@
+module log
+
+fn test_flag_mutators_preserve_and_clear_categories() {
+	mut logger := Log{}
+	logger.clear_and_set(.info)
+	assert logger.has(.info)
+	assert !logger.has(.log)
+	logger.set(.warn | .error)
+	assert logger.all(.info | .warn | .error)
+	logger.on(.debug)
+	logger.on(.debug)
+	assert logger.has(.debug)
+	logger.off(.warn)
+	logger.off(.warn)
+	assert !logger.has(.warn)
+	assert logger.all(.info | .error | .debug)
+	logger.toggle(.debug)
+	assert !logger.has(.debug)
+	logger.toggle(.debug)
+	assert logger.has(.debug)
+	logger.clear_and_set(.critical)
+	assert logger.has(.critical)
+	assert !logger.has(.info)
+	assert !logger.has(.error)
+	assert !logger.has(.debug)
+}
diff --git a/tests/native_allocators_test.v b/tests/native_allocators_test.v
new file mode 100644
index 0000000..cb34481
--- /dev/null
+++ b/tests/native_allocators_test.v
@@ -0,0 +1,29 @@
+import os
+
+fn test_native_bindings_and_allocators_with_and_without_boehm() {
+	root := os.join_path(os.vtmp_dir(), 'shy_native_allocators_${os.getpid()}')
+	os.mkdir_all(root) or { panic(err) }
+	defer { os.rmdir_all(root) or {} }
+	source := os.join_path(@VMODROOT, 'tests', 'testdata', 'native_allocators')
+	client := os.join_path(root, 'client')
+	os.cp_all(source, client, false) or { panic(err) }
+	os.write_file(os.join_path(client, 'v.mod'), "Module { name: 'shy_native_allocators' }\n") or {
+		panic(err)
+	}
+	binary := os.join_path(root, 'probe' + $if windows { '.exe' } $else { '' })
+	mut compilers := [[]string{}]
+	if _ := os.find_abs_path_of_executable('clang') {
+		compilers << ['-cc', 'clang']
+	}
+	for flags in compilers {
+		for mode in ['boehm', 'none'] {
+			mut args := [@VEXE, '-new-compiler', '-no-retry-compilation', '-gc', mode]
+			args << flags
+			args << ['-o', binary, client]
+			built := os.exec(args)
+			assert built.exit_code == 0, '${flags}, ${mode}: ${built.output}'
+			ran := os.exec([binary])
+			assert ran.exit_code == 0, '${flags}, ${mode}: ${ran.output}'
+		}
+	}
+}
diff --git a/tests/testdata/native_allocators/main.c.v b/tests/testdata/native_allocators/main.c.v
new file mode 100644
index 0000000..6b3a28d
--- /dev/null
+++ b/tests/testdata/native_allocators/main.c.v
@@ -0,0 +1,66 @@
+import shy.wraps.fontstash
+import shy.wraps.miniaudio as ma
+import shy.wraps.sokol.gl
+import shy.wraps.sokol.sfons
+
+fn verify_public_native_aliases() {
+	_ := ma.Engine{}
+	_ := ma.Sound{}
+	_ := ma.Decoder{}
+	context := gl.ContextDesc{
+		max_vertices: 32
+		max_commands: 16
+	}
+	assert context.max_vertices == 32
+	assert context.max_commands == 16
+	descriptor := gl.Desc{
+		max_vertices:       64
+		max_commands:       24
+		context_pool_size:  2
+		pipeline_pool_size: 4
+	}
+	assert descriptor.max_vertices == 64
+	assert descriptor.context_pool_size == 2
+	font := sfons.Desc{
+		width:  128
+		height: 256
+	}
+	assert font.width == 128
+	assert font.height == 256
+}
+
+fn verify_fontstash_allocations() {
+	params := C.FONSparams{
+		width:  16
+		height: 16
+	}
+	context := fontstash.create_internal(&params)
+	assert !isnil(context)
+	assert context.expand_atlas(32, 64) == 1
+	assert context.reset_atlas(16, 16) == 1
+	fontstash.delete_internal(context)
+}
+
+fn verify_miniaudio_allocations() {
+	mut data := &u8(ma.malloc(32, unsafe { nil }))
+	assert !isnil(data)
+	unsafe {
+		for i in 0 .. 32 {
+			data[i] = u8(i + 1)
+		}
+	}
+	data = &u8(ma.realloc(data, 128, unsafe { nil }))
+	assert !isnil(data)
+	unsafe {
+		for i in 0 .. 32 {
+			assert data[i] == u8(i + 1)
+		}
+	}
+	ma.free(data, unsafe { nil })
+}
+
+fn main() {
+	verify_public_native_aliases()
+	verify_fontstash_allocations()
+	verify_miniaudio_allocations()
+}
