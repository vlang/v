diff --git a/thread_test.v b/thread_test.v
new file mode 100644
index 0000000..c9d16f8
--- /dev/null
+++ b/thread_test.v
@@ -0,0 +1,25 @@
+module sdl
+
+fn thread_negative_status(_ voidptr) i32 {
+	return -37
+}
+
+fn test_wait_thread_widens_negative_c_int_status() {
+	worker := create_thread(thread_negative_status, c'negative_status', unsafe { nil })
+	assert worker != unsafe { nil }
+	mut status := 0
+	wait_thread(worker, &status)
+	assert status == -37
+}
+
+fn test_wait_thread_with_nil_thread_preserves_status() {
+	mut status := 91
+	wait_thread(unsafe { nil }, &status)
+	assert status == 91
+}
+
+fn test_wait_thread_with_nil_status_joins_thread() {
+	worker := create_thread(thread_negative_status, c'nil_status', unsafe { nil })
+	assert worker != unsafe { nil }
+	wait_thread(worker, unsafe { nil })
+}
