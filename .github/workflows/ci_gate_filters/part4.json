[
  {
    "workflow": "toml_ci.yml",
    "shard": "master",
    "mode": "paths",
    "patterns": [
      "vlib/**",
      ".github/actions/setup-v/**",
      "**/toml_ci.yml",
      ".github/workflows/ci_master.yml",
      "!**.md",
      "!vlib/v/gen/fastc/**",
      "!vlib/v/fastcdriver/**"
    ],
    "permissions": "contents: read",
    "inline": true
  },
  {
    "workflow": "tools_ci.yml",
    "shard": "master",
