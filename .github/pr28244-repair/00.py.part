from __future__ import annotations

import os
import re
from pathlib import Path

ROOT = Path(os.environ.get("REPO_ROOT", Path.cwd())).resolve()


def replace_once(path: Path, old: str, new: str) -> None:
    text = path.read_text()
    count = text.count(old)
    if count != 1:
        raise RuntimeError(f"{path}: expected exactly one anchor, found {count}: {old[:120]!r}")
    path.write_text(text.replace(old, new, 1))


def remove_regex_once(path: Path, pattern: str) -> None:
    text = path.read_text()
    new, count = re.subn(pattern, "", text, count=1, flags=re.S | re.M)
    if count != 1:
        raise RuntimeError(f"{path}: expected one regex match, found {count}: {pattern!r}")
    path.write_text(new)


def patch_checker() -> None:
    path = ROOT / "vlib/v3/types/checker_ownership_d_ownership.v"

    replace_once(
        path,
        "struct OwnershipState {\n",
        """enum OwnershipProjectionCopyAction {
\tno_action
\tclone_value
\treject_copy
}

struct OwnershipState {
""",
    )

    replace_once(
        path,
        "\tborrowed_storage_clone_reads     map[int]bool\n\tguard_move_reads                 map[int]bool\n",
        "\tborrowed_storage_clone_reads     map[int]bool\n"
        "\tprojection_copy_actions          map[int]OwnershipProjectionCopyAction\n"
        "\tguard_move_reads                 map[int]bool\n",
    )

    # The initializer shape occurs in new_ownership_state and in the parallel worker clone.
    text = path.read_text()
    old = (
        "\t\tborrowed_storage_clone_reads:     map[int]bool{}\n"
        "\t\tguard_move_reads:                 map[int]bool{}\n"
    )
    new = (
        "\t\tborrowed_storage_clone_reads:     map[int]bool{}\n"
        "\t\tprojection_copy_actions:          map[int]OwnershipProjectionCopyAction{}\n"
        "\t\tguard_move_reads:                 map[int]bool{}\n"
    )
    count = text.count(old)
    if count != 2:
        raise RuntimeError(f"{path}: expected two ownership-state initializer anchors, found {count}")
    path.write_text(text.replace(old, new))

    replace_once(
        path,
        """\tfor id, cloned in src.borrowed_storage_clone_reads {
\t\tif cloned {
\t\t\tdst.borrowed_storage_clone_reads[id] = true
\t\t}
\t}
\tfor id, moved in src.guard_move_reads {
""",
        """\tfor id, cloned in src.borrowed_storage_clone_reads {
\t\tif cloned {
\t\t\tdst.borrowed_storage_clone_reads[id] = true
\t\t}
\t}
\tfor id, action in src.projection_copy_actions {
\t\tif action != .no_action {
\t\t\tdst.projection_copy_actions[id] = action
\t\t}
\t}
\tfor id, moved in src.guard_move_reads {
""",
    )

    replace_once(
        path,
        """\t// Binding a field or slice read of borrowed storage copies it, so the new local
\t// owns an independent clone; the source is not moved and both are dropped
\t// separately (see ownership_expr_is_borrowed_projection).
\tif tc.ownership_expr_is_borrowed_projection(rhs_id) {
\t\ttc.ownership_mark_owned(lhs_name, tc.resolve_type(rhs_id), assign_id)
\t\treturn
\t}
""",
        """\t// The checker records one explicit action for each borrowed projection use. The
\t// transformer consumes that action instead of reclassifying the expression later.
\tmatch tc.ownership_prepare_projection_copy(rhs_id) {
\t\t.clone_value {
\t\t\ttc.ownership_mark_owned(lhs_name, tc.resolve_type(rhs_id), assign_id)
\t\t\treturn
\t\t}
\t\t.reject_copy {
\t\t\t// The diagnostic rejects this assignment. Keep error-recovery ownership from
\t\t\t// treating the shallow recovery value as an independent owner.
\t\t\tst.owned_vars.delete(lhs_name)
\t\t\tst.owned_var_types.delete(lhs_name)
\t\t\treturn
\t\t}
\t\t.no_action {}
\t}
""",
    )

    replace_once(
        path,
        """\t// Consuming a field or slice read of borrowed storage copies it: the consumer
\t// receives an independent clone and the source is not moved, so both are dropped
\t// separately (see ownership_expr_is_borrowed_projection).
\tif tc.ownership_expr_is_borrowed_projection(expr_id) {
\t\treturn
\t}
""",
        """\t// A borrowed projection never moves its retained source. Record whether lowering
\t// must clone it or reject the copy because the value is not cloneable.
\tif tc.ownership_prepare_projection_copy(expr_id) != .no_action {
\t\treturn
\t}
""",
    )

    replace_once(
        path,
        """// A field read of a directly-held value (a plain local or an owned global) keeps its
// Rust-like move semantics, diagnosed by the existing move analysis. Reads from immutable
// constants, including imported selectors and field/index projections rooted in constants,
// are borrowed instead. Only cloneable owned-storage types qualify; anything the compiler
// cannot structurally clone is left to the move path. The predicate depends only on node shape
// and node-annotated types, so the checker and the transformer reach the same decision without
// threading a per-node map across module boundaries.
""",
        """// A field read of a directly-held value (a plain local or an owned global) keeps its
// Rust-like move semantics, diagnosed by the existing move analysis. Reads from immutable
// constants, including imported selectors and field/index projections rooted in constants,
// are borrowed instead. Borrow classification is independent of cloneability: a borrowed
// destruction-bearing value that cannot be cloned is rejected by
// ownership_prepare_projection_copy rather than being misclassified as a move.
""",
    )

    replace_once(
        path,
        """\ttyp := tc.resolve_type(clean_id)
\tif !tc.ownership_type_requires_destruction(typ) {
\t\treturn false
\t}
\tif _ := tc.ownership_default_clone_missing_method(typ) {
\t\treturn false
\t}
\tif is_slice || is_deref || is_variant_cast || is_const_read {
""",
        """\ttyp := tc.resolve_type(clean_id)
\tif !tc.ownership_type_requires_destruction(typ) {
\t\treturn false
\t}
\tif is_slice || is_deref || is_variant_cast || is_const_read {
""",
    )

    insert_anchor = """\treturn tc.ownership_projection_reads_through_pointer(clean_id)
}

// ownership_expr_reads_const_storage reports whether an expression directly names a constant
"""
    insert_text = """\treturn tc.ownership_projection_reads_through_pointer(clean_id)
}

// ownership_prepare_projection_copy classifies one value-producing use of borrowed storage.
// Cloneability is deliberately checked after borrowedness so an uncloneable borrow is rejected
// instead of being mistaken for a move from storage that another value still owns.
fn (mut tc TypeChecker) ownership_prepare_projection_copy(id flat.NodeId) OwnershipProjectionCopyAction {
\tif !tc.ownership_expr_is_borrowed_projection(id) {
\t\treturn .no_action
\t}
\tclean_id := tc.ownership_unwrap_expr(id)
\tmut st := tc.ownership_state()
\tif action := st.projection_copy_actions[int(id)] {
\t\treturn action
\t}
\tif int(clean_id) != int(id) {
\t\tif action := st.projection_copy_actions[int(clean_id)] {
\t\t\tst.projection_copy_actions[int(id)] = action
\t\t\treturn action
\t\t}
\t}
\ttyp := tc.resolve_type(clean_id)
\tmut action := OwnershipProjectionCopyAction.clone_value
\tif bad_type := tc.ownership_default_clone_missing_method(typ) {
\t\ttc.record_error(.assignment_mismatch,
\t\t\t'cannot copy borrowed `${bad_type}`: the type requires ownership destruction but has no compatible `clone()` method; implement `IClone` or use a pointer',
\t\t\tid)
\t\taction = .reject_copy
\t}
\tst.projection_copy_actions[int(clean_id)] = action
\tst.projection_copy_actions[int(id)] = action
\treturn action
}

// ownership_expr_requires_borrowed_clone exposes the checker decision consumed by lowering.
// The transformer must not infer this again from expression shape or name resolution.
pub fn (tc &TypeChecker) ownership_expr_requires_borrowed_clone(id flat.NodeId) bool {
\tif int(id) < 0 || tc.ownership == unsafe { nil } {
\t\treturn false
\t}
\taction := tc.ownership.projection_copy_actions[int(id)] or { return false }
\treturn action == .clone_value
}

// ownership_expr_reads_const_storage reports whether an expression directly names a constant
"""
    replace_once(path, insert_anchor, insert_text)
