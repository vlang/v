def split_review_test() -> None:
    old_path = ROOT / "vlib/v3/tests/ownership_borrowed_projection_review_test.v"
    text = old_path.read_text()
    start_marker = "os.write_file(source, r'\n"
    end_marker = "\n')!\n\tfor mode in ['-no-parallel', ''] {"
    start = text.index(start_marker) + len(start_marker)
    end = text.index(end_marker, start)
    inner = text[start:end]

    blocks = extract_function_blocks(inner)
    test_blocks = {name: block for name, (_, _, block) in blocks.items() if name.startswith("test_")}
    main_span = blocks["main"][:2]

    remove_spans = [blocks[name][:2] for name in test_blocks]
    remove_spans.append(main_span)
    common_parts: list[str] = []
    cursor = 0
    for span_start, span_end in sorted(remove_spans):
        common_parts.append(inner[cursor:span_start])
        cursor = span_end
    common_parts.append(inner[cursor:])
    common = "".join(common_parts).strip() + "\n"

    main_block = blocks["main"][2]
    body_start = main_block.index("{") + 1
    main_body = main_block[body_start:main_block.rfind("}")]
    first_call = main_body.index("\ttest_reassign(holder)")
    holder_setup = main_body[:first_call].rstrip()
    call_lines = [line for line in main_body[first_call:].splitlines() if line.strip()]

    categories: dict[str, set[str]] = {
        "assignments": {
            "test_reassign",
            "test_mut_value_param_borrowed_reassign",
            "test_multi_assign",
            "test_pointer_dereferences_are_cloned",
            "test_conditional_borrowed_branches_are_cloned",
            "test_multi_conditional_borrowed_branches_are_cloned",
            "test_borrowed_or_fallback_is_cloned",
            "test_borrowed_or_success_is_cloned",
            "test_optional_selector_assignment_clones_borrowed_rhs",
            "test_sum_shared_field_assignment_clones_borrowed_rhs",
            "test_interface_field_assignment_clones_borrowed_rhs",
            "test_borrowed_sum_projection_is_cloned",
            "test_owned_rvalue_sum_projection_is_moved",
            "test_owned_rvalue_slice_projection_is_consumed",
            "test_nonaddressable_borrowed_projections_are_stable",
        },
        "calls_and_conversions": {
            "test_receiver_index_move_is_not_cloned",
            "test_direct_receiver_field_clone_is_retained",
            "test_variadic_receiver_field_clone_is_retained",
            "test_free_variadic_borrowed_projection_is_cloned",
            "test_borrowed_interface_argument_is_cloned",
            "test_disjoint_receiver_fields_are_not_cloned",
            "test_borrowed_fixed_array_conversions_are_cloned",
            "test_borrowed_dynamic_array_conversion_is_cloned",
            "test_pointer_backed_index_read_is_cloned",
            "test_borrowed_channel_send_is_cloned",
        },
        "collections": {
            "test_borrowed_array_push_many_is_cloned",
            "test_borrowed_append_is_cloned_once",
            "test_borrowed_prepend_and_insert_are_cloned",
            "test_borrowed_bulk_prepend_and_insert_are_cloned",
            "test_borrowed_array_initializer_is_cloned_per_element",
            "test_borrowed_array_literal_element_is_cloned",
            "test_borrowed_fixed_array_literal_element_is_cloned",
            "test_borrowed_fixed_array_initializer_is_cloned_per_element",
            "test_borrowed_optional_struct_field_is_cloned",
            "test_borrowed_optional_wrapper_is_not_dropped",
            "test_borrowed_map_literal_entries_are_cloned",
            "test_borrowed_map_assignment_is_cloned",
            "test_map_fixed_array_assignment_clones_borrowed_rhs",
            "test_borrowed_assoc_overrides_are_cloned",
        },
        "indexed_aliases": {
            "test_distinct_dynamic_map_keys",
            "test_distinct_static_map_keys",
            "test_function_alias_scope",
            "test_sibling_branch_alias_scope",
            "test_branch_alias_merge_is_conservative",
            "test_copied_index_alias_is_cloned",
            "test_long_index_alias_chain_is_cloned",
            "test_shadowed_index_alias_is_restored",
            "test_multi_assigned_index_alias_is_cloned",
            "test_fn_literal_captured_index_alias_is_cloned",
            "test_lambda_captured_index_alias_is_cloned",
            "test_distinct_dynamic_moved_map_slot_is_dropped",
        },
        "constants": {
            "test_same_module_const_shadow_is_moved",
            "test_same_module_const_projections_are_cloned",
            "test_same_typed_const_array_argument_is_cloned",
        },
    }
    assigned = set().union(*categories.values())
    missing = set(test_blocks) - assigned
    extra = assigned - set(test_blocks)
    if missing or extra:
        raise RuntimeError(f"test category mismatch; missing={sorted(missing)}, extra={sorted(extra)}")

    calls_by_category: dict[str, list[str]] = {name: [] for name in categories}
    for line in call_lines:
        match = re.search(r"\b(test_[A-Za-z0-9_]+)\s*\(", line)
        if match:
            test_name = match.group(1)
            category = next(name for name, tests in categories.items() if test_name in tests)
            calls_by_category[category].append(line)
        elif "holder.accept" in line:
            calls_by_category["calls_and_conversions"].append(line)
        else:
            raise RuntimeError(f"unclassified main statement: {line!r}")

    fixture_dir = ROOT / "vlib/v3/tests/testdata/ownership_borrowed_projection"
    fixture_dir.mkdir(parents=True, exist_ok=True)
    (fixture_dir / "common.v.txt").write_text(common)

    for category, names in categories.items():
        functions = "\n\n".join(test_blocks[name] for name in test_blocks if name in names)
        calls = "\n".join(calls_by_category[category])
        fixture = f"{functions}\n\nfn main() {{{holder_setup}\n{calls}\n}}\n"
        (fixture_dir / f"{category}.v.txt").write_text(fixture)

    (fixture_dir / "uncloneable_borrow.v.txt").write_text(
        """interface Drop {
mut:
\tdrop()
}

struct Resource implements Drop {
mut:
\tdrops &int
}

fn (mut value Resource) drop() {
\tunsafe {
\t\t*value.drops += 1
\t}
}

struct ResourceHolder {
\tvalue Resource
}

fn main() {
\tmut drops := 0
\tholder := &ResourceHolder{
\t\tvalue: Resource{
\t\t\tdrops: &drops
\t\t}
\t}
\tcopy := holder.value
\t_ = copy
}
"""
    )

    (fixture_dir / "toml_decode.v.txt").write_text(
        """module main

import toml

struct CommonStruct {
\tfield string
}

fn main() {
\tdoc := toml.parse_text('field = "some"')!
\tdecoded := doc.decode[CommonStruct]()!
\tassert decoded.field == 'some'
}
"""
    )
