
def split_review_test() -> None:
    old_path = ROOT / "vlib/v3/tests/ownership_borrowed_projection_review_test.v"
    text = old_path.read_text()
    start_marker = "os.write_file(source, r'\n"
    end_marker = "\n')!\n\tfor mode in ['-no-parallel', ''] {"
    start = text.index(start_marker) + len(start_marker)
    end = text.index(end_marker, start)
    inner = text[start:end]

    blocks = extract_function_blocks(inner)
    test_blocks = {name: block for name, (_, _, block) in blocks.items() if name.startswith("test_")}
    main_start, main_end, main_block = blocks["main"]

    remove_spans = [blocks[name][:2] for name in test_blocks]
    remove_spans.append((main_start, main_end))
    common_parts: list[str] = []
    cursor = 0
    for span_start, span_end in sorted(remove_spans):
        common_parts.append(inner[cursor:span_start])
        cursor = span_end
    common_parts.append(inner[cursor:])
    common = "".join(common_parts).strip() + "\n"
    clone_print = '\tprintln("clone")\n'
    if common.count(clone_print) != 1:
        raise RuntimeError(f"expected one common clone print, found {common.count(clone_print)}")
    common = common.replace(clone_print, "", 1)

    body_start = main_block.index("{") + 1
    main_body = main_block[body_start:main_block.rfind("}")]
    first_call = main_body.index("\ttest_reassign(holder)")
    holder_setup = main_body[:first_call].rstrip()
    call_lines = [line for line in main_body[first_call:].splitlines() if line.strip()]

    categories: dict[str, set[str]] = {
        "assignments": {
            "test_reassign",
            "test_mut_value_param_borrowed_reassign",
            "test_multi_assign",
            "test_pointer_dereferences_are_cloned",
            "test_conditional_borrowed_branches_are_cloned",
            "test_multi_conditional_borrowed_branches_are_cloned",
            "test_borrowed_or_fallback_is_cloned",
            "test_borrowed_or_success_is_cloned",
            "test_optional_selector_assignment_clones_borrowed_rhs",
            "test_sum_shared_field_assignment_clones_borrowed_rhs",
            "test_interface_field_assignment_clones_borrowed_rhs",
            "test_borrowed_sum_projection_is_cloned",
            "test_owned_rvalue_sum_projection_is_moved",
            "test_owned_rvalue_slice_projection_is_consumed",
            "test_nonaddressable_borrowed_projections_are_stable",
        },
        "calls_and_conversions": {
            "test_receiver_index_move_is_not_cloned",
            "test_direct_receiver_field_clone_is_retained",
            "test_variadic_receiver_field_clone_is_retained",
            "test_free_variadic_borrowed_projection_is_cloned",
            "test_borrowed_interface_argument_is_cloned",
            "test_disjoint_receiver_fields_are_not_cloned",
            "test_borrowed_fixed_array_conversions_are_cloned",
            "test_borrowed_dynamic_array_conversion_is_cloned",
            "test_pointer_backed_index_read_is_cloned",
            "test_borrowed_channel_send_is_cloned",
        },
        "collections": {
            "test_borrowed_array_push_many_is_cloned",
            "test_borrowed_append_is_cloned_once",
            "test_borrowed_prepend_and_insert_are_cloned",
            "test_borrowed_bulk_prepend_and_insert_are_cloned",
            "test_borrowed_array_initializer_is_cloned_per_element",
            "test_borrowed_array_literal_element_is_cloned",
            "test_borrowed_fixed_array_literal_element_is_cloned",
            "test_borrowed_fixed_array_initializer_is_cloned_per_element",
            "test_borrowed_optional_struct_field_is_cloned",
            "test_borrowed_optional_wrapper_is_not_dropped",
            "test_borrowed_map_literal_entries_are_cloned",
            "test_borrowed_map_assignment_is_cloned",
            "test_map_fixed_array_assignment_clones_borrowed_rhs",
            "test_borrowed_assoc_overrides_are_cloned",
        },
        "indexed_aliases": {
            "test_distinct_dynamic_map_keys",
            "test_distinct_static_map_keys",
            "test_function_alias_scope",
            "test_sibling_branch_alias_scope",
            "test_branch_alias_merge_is_conservative",
            "test_copied_index_alias_is_cloned",
            "test_long_index_alias_chain_is_cloned",
            "test_shadowed_index_alias_is_restored",
            "test_multi_assigned_index_alias_is_cloned",
            "test_fn_literal_captured_index_alias_is_cloned",
            "test_lambda_captured_index_alias_is_cloned",
            "test_distinct_dynamic_moved_map_slot_is_dropped",
        },
        "constants": {
            "test_same_module_const_shadow_is_moved",
            "test_same_module_const_projections_are_cloned",
            "test_same_typed_const_array_argument_is_cloned",
        },
    }
    assigned = set().union(*categories.values())
    missing = set(test_blocks) - assigned
    extra = assigned - set(test_blocks)
    if missing or extra:
        raise RuntimeError(f"test category mismatch; missing={sorted(missing)}, extra={sorted(extra)}")

    calls_by_category: dict[str, list[str]] = {name: [] for name in categories}
    for line in call_lines:
        match = re.search(r"\b(test_[A-Za-z0-9_]+)\s*\(", line)
        if match:
            test_name = match.group(1)
            category = next(name for name, tests in categories.items() if test_name in tests)
            calls_by_category[category].append(line)
        elif "holder.accept" in line:
            calls_by_category["calls_and_conversions"].append(line)
        else:
            raise RuntimeError(f"unclassified main statement: {line!r}")

    fixture_dir = ROOT / "vlib/v3/tests/testdata/ownership_borrowed_projection"
    fixture_dir.mkdir(parents=True, exist_ok=True)
    (fixture_dir / "common.v.txt").write_text(common)

    for category, names in categories.items():
        functions = "\n\n".join(test_blocks[name] for name in test_blocks if name in names)
        calls = "\n".join(calls_by_category[category])
        fixture = f"{functions}\n\nfn main() {{{holder_setup}\n{calls}\n}}\n"
        (fixture_dir / f"{category}.v.txt").write_text(fixture)

    imported_dir = fixture_dir / "imported_const"
    imported_dir.mkdir(exist_ok=True)
    (imported_dir / "v.mod.txt").write_text("Module { name: 'owned_const_shadow' }\n")
    (imported_dir / "cachemod.v.txt").write_text(
        """module cachemod

pub struct Payload implements IClone {
pub mut:
\tvalues []string
}

pub fn (value &Payload) clone() Payload {
\tprintln('clone')
\treturn Payload{
\t\tvalues: value.values.clone()
\t}
}

pub const cache = Payload{
\tvalues: ['constant']
}
"""
    )
    (imported_dir / "main.v.txt").write_text(
        """module main

import cachemod

fn drop_imported_const_projection() {
\tvalues := cachemod.cache.values
\tassert values[0] == 'constant'
}

fn main() {
\tcache := cachemod.Payload{
\t\tvalues: ['local']
\t}
\tdst := cache
\tassert dst.values[0] == 'local'

\tmut imported := cachemod.cache
\timported.values[0] = 'selector copy'
\tassert cachemod.cache.values[0] == 'constant'

\tdrop_imported_const_projection()
\tassert cachemod.cache.values[0] == 'constant'
}
"""
    )

    harness = """import os

const borrowed_projection_vexe = @VEXE
const borrowed_projection_tests_dir = os.dir(@FILE)
const borrowed_projection_v3_dir = os.dir(borrowed_projection_tests_dir)
const borrowed_projection_vlib_dir = os.dir(borrowed_projection_v3_dir)
const borrowed_projection_v3_src = os.join_path(borrowed_projection_v3_dir, 'v3.v')
const borrowed_projection_fixture_dir = os.join_path(borrowed_projection_tests_dir, 'testdata',
\t'ownership_borrowed_projection')

fn build_borrowed_projection_v3() string {
\tv3_bin := os.join_path(os.temp_dir(), 'v3_borrowed_projection_${os.getpid()}')
\tos.rm(v3_bin) or {}
\tbuild := os.execute('${borrowed_projection_vexe} -nocache -gc none -d ownership -path "${borrowed_projection_vlib_dir}|@vlib|@vmodules" -o ${v3_bin} ${borrowed_projection_v3_src}')
\tassert build.exit_code == 0, build.output
\treturn v3_bin
}

fn run_borrowed_projection_source(v3_bin string, name string, source_text string) {
\tsource := os.join_path(os.temp_dir(), 'v3_borrowed_projection_${name}_${os.getpid()}.v')
\tdefer {
\t\tos.rm(source) or {}
\t}
\tos.write_file(source, source_text) or { panic(err) }
\tfor mode in ['-no-parallel', ''] {
\t\tout := os.execute('${v3_bin} -nocache -ownership -d ownership ${mode} run ${source}')
\t\tassert out.exit_code == 0, '${name} (${mode}): ${out.output}'
\t}
}

fn test_borrowed_projection_regressions_by_context() {
\tv3_bin := build_borrowed_projection_v3()
\tdefer {
\t\tos.rm(v3_bin) or {}
\t}
\tcommon := os.read_file(os.join_path(borrowed_projection_fixture_dir, 'common.v.txt')) or {
\t\tpanic(err)
\t}
\tfor name in ['assignments', 'calls_and_conversions', 'collections', 'indexed_aliases',
\t\t'constants'] {
\t\tfragment := os.read_file(os.join_path(borrowed_projection_fixture_dir,
\t\t\t'${name}.v.txt')) or { panic(err) }
\t\trun_borrowed_projection_source(v3_bin, name, common + '\\n' + fragment)
\t}
\trun_imported_const_projection_is_cloned(v3_bin)
}

fn run_imported_const_projection_is_cloned(v3_bin string) {
\tproject := os.join_path(os.temp_dir(), 'v3_owned_const_shadow_${os.getpid()}')
\tos.rmdir_all(project) or {}
\tos.mkdir_all(os.join_path(project, 'cachemod')) or { panic(err) }
\tdefer {
\t\tos.rmdir_all(project) or {}
\t}
\tfixtures := os.join_path(borrowed_projection_fixture_dir, 'imported_const')
\tos.cp(os.join_path(fixtures, 'v.mod.txt'), os.join_path(project, 'v.mod')) or { panic(err) }
\tos.cp(os.join_path(fixtures, 'cachemod.v.txt'), os.join_path(project, 'cachemod',
\t\t'cachemod.v')) or { panic(err) }
\tos.cp(os.join_path(fixtures, 'main.v.txt'), os.join_path(project, 'main.v')) or { panic(err) }
\tfor mode in ['-no-parallel', ''] {
\t\tout := os.execute('${v3_bin} -nocache -ownership -d ownership ${mode} run ${os.join_path(project,
\t\t\t'main.v')}')
\t\tassert out.exit_code == 0, out.output
\t\tassert out.output.count('clone') == 1, out.output
\t}
}
"""
    old_path.write_text(harness)

    error_path = ROOT / "vlib/v3/tests/ownership_borrowed_projection_error_test.v"
    error_path.write_text(r'''import os

const borrowed_projection_error_vexe = @VEXE
const borrowed_projection_error_tests_dir = os.dir(@FILE)
const borrowed_projection_error_v3_dir = os.dir(borrowed_projection_error_tests_dir)
const borrowed_projection_error_vlib_dir = os.dir(borrowed_projection_error_v3_dir)
const borrowed_projection_error_v3_src = os.join_path(borrowed_projection_error_v3_dir, 'v3.v')
const borrowed_projection_uncloneable_prelude = r'
interface Drop {
mut:
\tdrop()
}

struct Resource implements Drop {
mut:
\tvalues []string
}

fn (mut value Resource) drop() {
\tvalue.values = []
}

struct Holder {
\tvalue Resource
}
'

fn assert_uncloneable_borrowed_copy_error(v3_bin string, case_name string, body string, expected string) {
\tsource := os.join_path(os.temp_dir(), 'v3_borrowed_projection_error_${case_name}_${os.getpid()}.v')
\tos.rm(source) or {}
\tdefer {
\t\tos.rm(source) or {}
\t}
\tos.write_file(source, borrowed_projection_uncloneable_prelude + body)!
\tfor mode in ['-no-parallel', ''] {
\t\tout := os.execute('${v3_bin} -nocache -ownership -d ownership ${mode} run ${source}')
\t\tassert out.exit_code != 0, '${case_name}: ${out.output}'
\t\tassert out.output.contains(expected), '${case_name}: ${out.output}'
\t\tassert out.output.contains('requires ownership destruction but has no compatible `clone()` method'),
\t\t\t'${case_name}: ${out.output}'
\t\tassert out.output.contains('implement `IClone` or use a pointer'), '${case_name}: ${out.output}'
\t}
}

fn test_uncloneable_borrowed_projection_copies_are_rejected() {
\tv3_bin := os.join_path(os.temp_dir(), 'v3_borrowed_projection_error_test_${os.getpid()}')
\tos.rm(v3_bin) or {}
\tdefer {
\t\tos.rm(v3_bin) or {}
\t}
\tbuild :=
\t\tos.execute('${borrowed_projection_error_vexe} -nocache -gc none -d ownership -path "${borrowed_projection_error_vlib_dir}|@vlib|@vmodules" -o ${v3_bin} ${borrowed_projection_error_v3_src}')
\tassert build.exit_code == 0, build.output

\tassert_uncloneable_borrowed_copy_error(v3_bin, 'field', r'
fn copy_borrowed_field(holder &Holder) {
\tcopied := holder.value
\t_ = copied
}

fn main() {
\tholder := &Holder{
\t\tvalue: Resource{
\t\t\tvalues: ["owned"]
\t\t}
\t}
\tcopy_borrowed_field(holder)
}
', 'cannot copy borrowed `Resource` value')

\tassert_uncloneable_borrowed_copy_error(v3_bin, 'receiver', r'
fn (holder &Holder) take(value Resource) {
\t_ = holder
\t_ = value
}

fn main() {
\tholder := Holder{
\t\tvalue: Resource{
\t\t\tvalues: ["owned"]
\t\t}
\t}
\tholder.take(holder.value)
}
', 'cannot copy receiver-aliased `Resource` value')
}
''')

    toml_path = ROOT / "vlib/v3/tests/ownership_toml_decode_test.v"
    toml_path.write_text(r'''import os

const ownership_toml_vexe = @VEXE
const ownership_toml_tests_dir = os.dir(@FILE)
const ownership_toml_v3_dir = os.dir(ownership_toml_tests_dir)
const ownership_toml_vlib_dir = os.dir(ownership_toml_v3_dir)
const ownership_toml_v3_src = os.join_path(ownership_toml_v3_dir, 'v3.v')

fn test_toml_decode_with_ownership() {
\tv3_bin := os.join_path(os.temp_dir(), 'v3_ownership_toml_${os.getpid()}')
\tsource := os.join_path(os.temp_dir(), 'v3_ownership_toml_${os.getpid()}.v')
\tos.rm(v3_bin) or {}
\tdefer {
\t\tos.rm(v3_bin) or {}
\t\tos.rm(source) or {}
\t}
\tbuild := os.execute('${ownership_toml_vexe} -nocache -gc none -d ownership -path "${ownership_toml_vlib_dir}|@vlib|@vmodules" -o ${v3_bin} ${ownership_toml_v3_src}')
\tassert build.exit_code == 0, build.output
\tos.write_file(source, r'
module main

import toml

struct CommonStruct {
\tfield string
}

fn main() {
\tdoc := toml.parse_text("field = \\"some\\"")!
\tdecoded := doc.decode[CommonStruct]()!
\tassert decoded.field == "some"
}
')!
\tfor mode in ['-no-parallel', ''] {
\t\tout := os.execute('${v3_bin} -nocache -ownership -d ownership ${mode} run ${source}')
\t\tassert out.exit_code == 0, out.output
\t}
}
''')
