

_split_review_test_with_fixture_files = split_review_test


def split_review_test() -> None:
    _split_review_test_with_fixture_files()
    error_path = ROOT / "vlib/v3/tests/ownership_borrowed_projection_error_test.v"
    error_path.write_text(error_path.read_text().replace(r"\t", "\t"))

    toml_path = ROOT / "vlib/v3/tests/ownership_toml_decode_test.v"
    toml_text = toml_path.read_text().replace(r"\t", "\t")
    old_parse = r'doc := toml.parse_text(\"field = \\\\\"some\\\\\"\")!'
    new_parse = r'doc := toml.parse_text("field = \"some\"")!'
    if old_parse not in toml_text:
        raise RuntimeError("generated TOML parse source anchor was not found")
    toml_text = toml_text.replace(old_parse, new_parse, 1)
    old_assert = r'assert decoded.field == \"some\"'
    if old_assert not in toml_text:
        raise RuntimeError("generated TOML assertion anchor was not found")
    toml_path.write_text(toml_text.replace(old_assert, 'assert decoded.field == "some"', 1))
