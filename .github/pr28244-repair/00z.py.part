
def patch_checker() -> None:
    path = ROOT / "vlib/v3/types/checker_ownership_d_ownership.v"

    replace_once(
        path,
        "const ownership_unknown_pointer_index_alias = '<unknown-index-alias>'\n\n",
        """const ownership_unknown_pointer_index_alias = '<unknown-index-alias>'

enum OwnershipBorrowedProjectionAction {
\tnot_borrowed
\tclone_value
\treject_copy
}

""",
    )

    replace_once(
        path,
        "\treceiver_alias_clone_reads       map[int]bool\n\tpointer_index_aliases            map[string]string\n",
        "\treceiver_alias_clone_reads       map[int]bool\n"
        "\tborrowed_projection_actions      map[int]OwnershipBorrowedProjectionAction\n"
        "\tpointer_index_aliases            map[string]string\n",
    )

    text = path.read_text()
    old = (
        "\t\treceiver_alias_clone_reads:       map[int]bool{}\n"
        "\t\tpointer_index_aliases:            map[string]string{}\n"
    )
    new = (
        "\t\treceiver_alias_clone_reads:       map[int]bool{}\n"
        "\t\tborrowed_projection_actions:      map[int]OwnershipBorrowedProjectionAction{}\n"
        "\t\tpointer_index_aliases:            map[string]string{}\n"
    )
    count = text.count(old)
    if count != 2:
        raise RuntimeError(f"{path}: expected two ownership-state initializer anchors, found {count}")
    path.write_text(text.replace(old, new))

    replace_once(
        path,
        """\tfor id, cloned in src.receiver_alias_clone_reads {
\t\tif cloned {
\t\t\tdst.receiver_alias_clone_reads[id] = true
\t\t}
\t}
\tfor id, cloned in src.borrowed_storage_clone_reads {
""",
        """\tfor id, cloned in src.receiver_alias_clone_reads {
\t\tif cloned {
\t\t\tdst.receiver_alias_clone_reads[id] = true
\t\t}
\t}
\tfor id, action in src.borrowed_projection_actions {
\t\tdst.borrowed_projection_actions[id] = action
\t}
\tfor id, cloned in src.borrowed_storage_clone_reads {
""",
    )

    replace_once(
        path,
        """\t\texpected := tc.ownership_call_arg_expected_type(info, type_param_idx, variadic_elem_idx)
\t\tif tc.ownership_call_arg_clones_receiver_storage(node, info, arg_id, expected) {
\t\t\tcontinue
\t\t}
""",
        """\t\texpected := tc.ownership_call_arg_expected_type(info, type_param_idx, variadic_elem_idx)
\t\tif expected !is Void && expected !is Pointer
\t\t\t&& tc.ownership_expr_borrows_storage(arg_id) {
\t\t\tcontinue
\t\t}
\t\tif tc.ownership_call_arg_reads_receiver_storage(node, info, arg_id, expected) {
\t\t\tcontinue
\t\t}
""",
    )

    replace_once(
        path,
        """\t// Binding a field or slice read of borrowed storage copies it, so the new local
\t// owns an independent clone; the source is not moved and both are dropped
\t// separately (see ownership_expr_is_borrowed_projection).
\tif tc.ownership_expr_is_borrowed_projection(rhs_id) {
\t\ttc.ownership_mark_owned(lhs_name, tc.resolve_type(rhs_id), assign_id)
\t\treturn
\t}
""",
        """\t// A read from retained storage either becomes an independent clone or is rejected.
\t// Never let an uncloneable borrowed read fall through to move bookkeeping.
\tmatch tc.ownership_borrowed_projection_action(rhs_id, assign_id) {
\t\t.clone_value {
\t\t\ttc.ownership_mark_owned(lhs_name, tc.resolve_type(rhs_id), assign_id)
\t\t\treturn
\t\t}
\t\t.reject_copy {
\t\t\t// The diagnostic rejects this assignment. Keep the shallow recovery value
\t\t\t// non-owning so error recovery cannot destroy storage retained by the source.
\t\t\tst.owned_vars.delete(lhs_name)
\t\t\tst.owned_var_types.delete(lhs_name)
\t\t\treturn
\t\t}
\t\t.not_borrowed {}
\t}
""",
    )

    replace_once(
        path,
        """\t\tif tc.ownership_mark_array_insert_prepend_arg(node, call_name, param_idx, arg_id, id) {
\t\t\tcontinue
\t\t}
\t\tif tc.ownership_call_arg_clones_receiver_storage(node, info, arg_id, expected) {
\t\t\tst.receiver_alias_clone_reads[int(arg_id)] = true
\t\t\tcontinue
\t\t}
""",
        """\t\tif tc.ownership_mark_array_insert_prepend_arg(node, call_name, param_idx, arg_id, id) {
\t\t\t_ = tc.ownership_borrowed_projection_action(arg_id, arg_id)
\t\t\tcontinue
\t\t}
\t\tif expected !is Void && expected !is Pointer
\t\t\t&& tc.ownership_borrowed_projection_action(arg_id, arg_id) != .not_borrowed {
\t\t\tcontinue
\t\t}
\t\tif tc.ownership_prepare_receiver_alias_arg_clone(node, info, arg_id, expected) {
\t\t\tcontinue
\t\t}
""",
    )

    replace_once(
        path,
        """fn (tc &TypeChecker) ownership_call_arg_clones_receiver_storage(node flat.Node, info CallInfo, arg_id flat.NodeId, expected Type) bool {
""",
        """fn (tc &TypeChecker) ownership_call_arg_reads_receiver_storage(node flat.Node, info CallInfo, arg_id flat.NodeId, expected Type) bool {
""",
    )

    replace_once(
        path,
        """\tif recv_name.len == 0 || arg_name.len == 0
\t\t|| !ownership_storage_keys_overlap(recv_name, arg_name)
\t\t|| tc.ownership_expr_has_index_projection(arg_id)
\t\t|| tc.ownership_expr_is_borrowed_projection(arg_id) {
\t\treturn false
\t}
\targ_type := tc.resolve_type(arg_id)
\treturn tc.ownership_type_requires_destruction(arg_type)
\t\t&& tc.ownership_default_clone_missing_method(arg_type) == none
}

fn (tc &TypeChecker) ownership_expr_has_index_projection(id flat.NodeId) bool {
""",
        """\tif recv_name.len == 0 || arg_name.len == 0
\t\t|| !ownership_storage_keys_overlap(recv_name, arg_name)
\t\t|| tc.ownership_expr_has_index_projection(arg_id)
\t\t|| tc.ownership_expr_borrows_storage(arg_id) {
\t\treturn false
\t}
\treturn tc.ownership_type_requires_destruction(tc.resolve_type(arg_id))
}

// ownership_prepare_receiver_alias_arg_clone records the same explicit clone-or-reject
// decision for directly held receiver fields that overlap a retained method receiver.
fn (mut tc TypeChecker) ownership_prepare_receiver_alias_arg_clone(node flat.Node, info CallInfo, arg_id flat.NodeId, expected Type) bool {
\tif !tc.ownership_call_arg_reads_receiver_storage(node, info, arg_id, expected) {
\t\treturn false
\t}
\targ_type := tc.resolve_type(arg_id)
\tif bad_type := tc.ownership_default_clone_missing_method(arg_type) {
\t\ttc.record_error(.call_arg_mismatch,
\t\t\t'cannot copy receiver-aliased `${arg_type.name()}` value: `${bad_type}` requires ownership destruction but has no compatible `clone()` method; implement `IClone` or use a pointer',
\t\t\targ_id)
\t\treturn true
\t}
\ttc.ownership_state().receiver_alias_clone_reads[int(arg_id)] = true
\treturn true
}

fn (tc &TypeChecker) ownership_expr_has_index_projection(id flat.NodeId) bool {
""",
    )

    replace_once(
        path,
        """\t// Consuming a field or slice read of borrowed storage copies it: the consumer
\t// receives an independent clone and the source is not moved, so both are dropped
\t// separately (see ownership_expr_is_borrowed_projection).
\tif tc.ownership_expr_is_borrowed_projection(expr_id) {
\t\treturn
\t}
""",
        """\t// A consumer of retained storage receives an independent clone. If cloning is not
\t// available, report the error while still keeping the source owned.
\tif tc.ownership_borrowed_projection_action(expr_id, at) != .not_borrowed {
\t\treturn
\t}
""",
    )

    pattern = r"// ownership_expr_is_borrowed_projection reports whether `id` reads storage another value.*?(?=// ownership_expr_reads_const_storage reports whether an expression directly names a constant)"
    replacement = """// ownership_expr_is_borrowed_projection reports whether ownership checking selected an
// independent clone for `id`. The transformer consumes this recorded decision instead of
// re-resolving lexical names after checking has finished.
pub fn (tc &TypeChecker) ownership_expr_is_borrowed_projection(id flat.NodeId) bool {
\tif tc.ownership == unsafe { nil } || !tc.valid_node_id(id) {
\t\treturn false
\t}
\tif action := tc.ownership.borrowed_projection_actions[int(id)] {
\t\treturn action == .clone_value
\t}
\tclean_id := tc.ownership_unwrap_expr(id)
\tif clean_id == id || !tc.valid_node_id(clean_id) {
\t\treturn false
\t}
\tif action := tc.ownership.borrowed_projection_actions[int(clean_id)] {
\t\treturn action == .clone_value
\t}
\treturn false
}

// ownership_borrowed_projection_action records how a read from retained storage is handled.
// Cloneable values are marked for lowering; uncloneable values are rejected and never fall
// through to move bookkeeping.
fn (mut tc TypeChecker) ownership_borrowed_projection_action(id flat.NodeId, pos flat.NodeId) OwnershipBorrowedProjectionAction {
\tif !tc.ownership_expr_borrows_storage(id) {
\t\treturn .not_borrowed
\t}
\tclean_id := tc.ownership_unwrap_expr(id)
\tmut st := tc.ownership_state()
\tif action := st.borrowed_projection_actions[int(id)] {
\t\treturn action
\t}
\tif clean_id != id {
\t\tif action := st.borrowed_projection_actions[int(clean_id)] {
\t\t\tst.borrowed_projection_actions[int(id)] = action
\t\t\treturn action
\t\t}
\t}
\ttyp := tc.resolve_type(clean_id)
\tmut action := OwnershipBorrowedProjectionAction.clone_value
\tif bad_type := tc.ownership_default_clone_missing_method(typ) {
\t\ttc.record_error(.assignment_mismatch,
\t\t\t'cannot copy borrowed `${typ.name()}` value: `${bad_type}` requires ownership destruction but has no compatible `clone()` method; implement `IClone` or use a pointer',
\t\t\tpos)
\t\taction = .reject_copy
\t}
\tst.borrowed_projection_actions[int(id)] = action
\tif clean_id != id {
\t\tst.borrowed_projection_actions[int(clean_id)] = action
\t}
\treturn action
}

// ownership_expr_borrows_storage reports whether `id` reads storage another value keeps
// owning and therefore cannot be moved. A field read of a directly-held value keeps its
// Rust-like move semantics; cloneability is deliberately decided separately above.
fn (tc &TypeChecker) ownership_expr_borrows_storage(id flat.NodeId) bool {
\tif tc.ownership == unsafe { nil } {
\t\treturn false
\t}
\tclean_id := tc.ownership_unwrap_expr(id)
\tif !tc.valid_node_id(clean_id) {
\t\treturn false
\t}
\tnode := tc.a.nodes[int(clean_id)]
\tis_field := node.kind == .selector && node.children_count > 0 && node.value.len > 0
\tis_slice := node.kind == .index && node.value == 'range'
\tis_index := node.kind == .index && node.value != 'range' && node.children_count > 0
\tis_deref := node.kind == .prefix && node.op == .mul && node.children_count > 0
\t// A sum-type/interface cast from retained named storage copies its payload. An owned
\t// rvalue such as `make_entry() as T` instead transfers the projected payload.
\tvariant_source_id := if node.kind == .as_expr && node.children_count > 0 {
\t\ttc.a.child(&node, 0)
\t} else {
\t\tflat.empty_node
\t}
\tis_variant_cast := variant_source_id != flat.empty_node
\t\t&& tc.ownership_expr_ident_name(variant_source_id).len > 0
\t\t&& unwrap_pointer(tc.resolve_type(variant_source_id)) == tc.resolve_type(variant_source_id)
\tis_const_read := tc.ownership_expr_reads_const_storage(clean_id)
\tif !is_field && !is_slice && !is_index && !is_deref && !is_variant_cast && !is_const_read {
\t\treturn false
\t}
\tif !tc.ownership_type_requires_destruction(tc.resolve_type(clean_id)) {
\t\treturn false
\t}
\tif is_slice || is_deref || is_variant_cast || is_const_read {
\t\treturn true
\t}
\treturn tc.ownership_projection_reads_through_pointer(clean_id)
}

"""
    text = path.read_text()
    new_text, count = re.subn(pattern, replacement, text, count=1, flags=re.S)
    if count != 1:
        raise RuntimeError(f"{path}: expected one borrowed-projection function block, found {count}")
    path.write_text(new_text)
