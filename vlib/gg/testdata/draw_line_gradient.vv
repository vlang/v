module main

import gg

gg.start(
	bg_color:     gg.white
	window_title: 'Line thickness and gradients'
	width:        260
	height:       150
	frame_fn:     fn (ctx &gg.Context) {
		ctx.begin()
		ctx.draw_line_with_thickness(15, 20, 235, 55, 8, gg.blue)
		ctx.draw_rect_filled_gradient(15, 75, 220, 55, gg.red, gg.blue, gg.green, gg.yellow)
		ctx.end()
	}
)
