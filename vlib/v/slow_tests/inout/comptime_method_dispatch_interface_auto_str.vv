interface IFoo {
	name string
}

struct Foo {
	name string
}

struct Model {}

fn (model Model) get_foo() IFoo {
	return Foo{
		name: 'interface value'
	}
}

fn (mut model Model) run() {
	mut value := model.get_foo()
	println(value)
}

fn dispatch[T](mut model T) {
	$for method in T.methods {
		if method.name == 'run' {
			$if method.typ is fn ( ) {
				model.$method()
				return
			}
		}
	}
}

fn main() {
	mut model := Model{}
	dispatch(mut model)
}
