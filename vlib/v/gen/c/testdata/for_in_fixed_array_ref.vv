module main

struct Point {
	x int
	y int
}

struct Holder {
	buf [3]Point
}

struct PointerHolder {
	buf [2]&Point
}

type PointPtr = &Point

struct AliasPointerHolder {
mut:
	buf [2]PointPtr
}

fn increment(value int) int {
	return value + 1
}

fn double(value int) int {
	return value * 2
}

fn main() {
	h := Holder{
		buf: [Point{1, 2}, Point{3, 4}, Point{5, 6}]!
	}
	for i in &h.buf {
		println(i.x)
	}
	first := &Point{7, 8}
	second := &Point{9, 10}
	pointers := PointerHolder{
		buf: [first, second]!
	}
	for point in &pointers.buf {
		println(point.x)
	}
	mut alias_pointers := AliasPointerHolder{
		buf: [PointPtr(first), PointPtr(second)]!
	}
	for mut point_ref in alias_pointers.buf {
		_ = point_ref
	}
	callbacks := [increment, double]!
	unsafe {
		for callback in &callbacks {
			_ = callback
		}
	}
}
