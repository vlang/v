enum RasterizationMode as u32 {
	default  = 0
	max_enum = max_int
}

type RasterizationModeExt = RasterizationMode

struct Config {
	mode RasterizationModeExt
}

fn main() {
	config := Config{}
	println(u32(config.mode))
	println(RasterizationMode.max_enum.str())
	println(match RasterizationMode.max_enum {
		.max_enum { 'max' }
		else { 'other' }
	})
}
