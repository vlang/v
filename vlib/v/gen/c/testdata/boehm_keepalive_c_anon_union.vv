// vtest vflags: -prod -gc boehm_full_opt
#include "@VMODROOT/vlib/v/gen/c/testdata/boehm_keepalive_c_anon_union.h"

union C.anon_u {
mut:
	u u32
	a u8
	p voidptr
}

struct C.anon_s {
mut:
	n int
	p voidptr
}

@[typedef]
struct C.TestAnonRecord {
mut:
	kind   int
	anon_u C.anon_u
	anon_s C.anon_s
}

struct C.TestAnonEvent {
mut:
	events u32
	record C.TestAnonRecord
}

fn consume(rec &C.TestAnonRecord) {
	_ = rec
}

fn trigger_pin(ev C.TestAnonEvent) {
	consume(&ev.record)
}

fn main() {
	mut ev := C.TestAnonEvent{}
	ev.record.kind = 42
	trigger_pin(ev)
	println('ok')
}
