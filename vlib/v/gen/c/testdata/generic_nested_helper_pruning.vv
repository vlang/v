module main

struct GenericHelperStruct {
	value int
}

struct GenericMethodContext[T] {}

fn helper_value[T](value T) string {
	return typeof(value).name
}

fn wrap_value[T](value T) string {
	return helper_value(value)
}

fn helper_array[T](value []T) int {
	return value.len
}

fn wrap_array[T](value []T) int {
	return helper_array(value)
}

fn helper_map[K, V](value map[K]V) int {
	return value.len
}

fn wrap_map[K, V](value map[K]V) int {
	return helper_map(value)
}

fn (c GenericMethodContext[T]) render(value []T) int {
	return value.len
}

fn wrap_method[T](value []T) int {
	c := GenericMethodContext[T]{}
	return c.render(value)
}

fn main() {
	_ = wrap_value(u8(1))
	_ = wrap_value(u16(2))
	_ = wrap_value(GenericHelperStruct{3})
	_ = wrap_array([u8(1), 2])
	_ = wrap_array([u16(1), 2])
	_ = wrap_array(['a', 'b'])
	_ = wrap_map({
		'a': u8(1)
	})
	_ = wrap_map({
		'a': u16(1)
	})
	_ = wrap_map({
		'a': GenericHelperStruct{1}
	})
	_ = wrap_method([u8(1), 2])
	_ = wrap_method([u16(1), 2])
	_ = wrap_method(['a', 'b'])
}
