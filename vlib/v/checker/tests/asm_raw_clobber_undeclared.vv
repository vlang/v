fn raw_call_to_a_quoted_plain_label_is_not_checked() u64 {
	mut pc := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"call \"raw_get_pc\"\n"
		"\"raw_get_pc\": popq %%rbx\n\t"
		"movq %%rbx, %[pc]\n\t"
		"popq %%rbx"
		; [pc] "=r" (pc)
	}
	return pc
}

fn raw_i386_call_after_a_balanced_push_is_checked() {
	asm i386 raw {
		"push %%ebx\n\t"
		"pop %%ebx\n\t"
		"call abort\n\t"
		"movl $1, %%esi"
		; 
		; 
		; memory
	}
}

fn raw_every_register_spelling_is_a_write() {
	asm amd64 raw {
		"movq $1, %%rax"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%eax"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%ax"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%al"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%ah"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movq $1, %%rbx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%ebx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%bx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%bl"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%bh"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movq $1, %%rcx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%ecx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%cx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%cl"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%ch"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movq $1, %%rdx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%edx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%dx"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%dl"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%dh"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movq $1, %%rsi"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%esi"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%si"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%sil"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movq $1, %%rdi"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%edi"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%di"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%dil"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movq $1, %%rbp"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movl $1, %%ebp"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movw $1, %%bp"
		; 
		; 
		; 
	}
	asm amd64 raw {
		"movb $1, %%bpl"
		; 
		; 
		; 
	}
}

fn raw_braced_rdi_does_not_declare_rdx(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"movq $1, %%rdi\n\t"
		"movq $2, %%rdx"
		; [y] "={rdi}" (y)
		; 
		; 
	}
	return y
}

fn raw_call_to_a_quoted_plain_symbol_is_followed() {
	asm amd64 raw {
		"call \"abort\"\n\t"
		"movq $1, %%rsi"
		; 
		; 
		; memory
	}
}

fn raw_call_to_symbols_with_punctuation_is_followed() {
	asm amd64 raw {
		"call raw_fn_a\n\t"
		"call raw.fn\n\t"
		"call raw$fn\n\t"
		"call memcpy@PLT\n\t"
		"movq $1, %%rsi"
		; 
		; 
		; memory
	}
}

fn raw_cfi_directive_naming_rsp_is_skipped() {
	asm amd64 raw {
		".cfi_def_cfa %%rsp, 16\n\t"
		"movq $1, %%rsi"
		; 
		; 
		; 
	}
}

fn raw_frame_ended_by_mov_and_pop_is_closed() {
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"movq %%rbp, %%rsp\n\t"
		"popq %%rbp\n\t"
		"movq %%rbp, %%rsi"
		; 
		; 
		; 
	}
}

fn raw_frame_ended_by_leaveq_or_leavel_is_closed() {
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"leaveq\n\t"
		"movq %%rbp, %%rsi"
		; 
		; 
		; 
	}
	asm i386 raw {
		"pushl %%ebp\n\t"
		"movl %%esp, %%ebp\n\t"
		"leavel\n\t"
		"movl %%ebp, %%esi"
		; 
		; 
		; 
	}
}

fn raw_suffixed_mul_and_div_of_memory_write_rdx() {
	asm amd64 raw {
		"mulw (%%rbx)\n\t"
		"mull (%%rbx)\n\t"
		"imull (%%rbx)\n\t"
		"divl (%%rbx)\n\t"
		"idivl (%%rbx)"
		; 
		; 
		; cc memory
	}
}

fn raw_rep_prefix_spellings_write_rcx() {
	asm amd64 raw {
		"repe cmpsb\n\t"
		"repz scasb\n\t"
		"repnz scasb\n\t"
		"repne scasb"
		; 
		; 
		; cc memory
	}
}

fn raw_rep_on_its_own_line_reaches_past_a_label() {
	asm amd64 raw {
		"rep\n\t"
		"1:\n\t"
		"movsb"
		; 
		; 
		; memory
	}
}

fn raw_pop_into_rbp_outside_a_frame_is_checked() {
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"popq %%rbp\n\t"
		"movq $1, %%rsi"
		; 
		; 
		; 
	}
}

fn raw_rep_movsd_without_operands_writes_rcx() {
	asm amd64 raw {
		"rep movsd"
		; 
		; 
		; rsi rdi memory
	}
}

fn raw_repe_cmpsd_without_operands_writes_rcx() {
	asm amd64 raw {
		"repe cmpsd"
		; 
		; 
		; rsi rdi cc memory
	}
}

fn raw_wait_on_a_line_of_its_own_is_checked() {
	asm amd64 raw {
		"wait\n\t"
		"movq $1, %%rbx"
		; 
		; 
		; 
	}
}

fn raw_rep_smovb_writes_rcx() {
	asm amd64 raw {
		"rep smovb"
		; 
		; 
		; rsi rdi memory
	}
}

fn raw_rep_sstoq_writes_rcx() {
	asm amd64 raw {
		"rep sstoq"
		; 
		; 
		; rdi memory
	}
}

fn raw_rep_slodb_writes_rcx() {
	asm amd64 raw {
		"rep slodb"
		;
		;
		; rax rsi memory
	}
}

fn raw_repz_scmpb_writes_rcx() {
	asm amd64 raw {
		"repz scmpb"
		;
		;
		; rsi rdi cc memory
	}
}

fn raw_repz_sscab_writes_rcx() {
	asm amd64 raw {
		"repz sscab"
		;
		;
		; rdi cc memory
	}
}

