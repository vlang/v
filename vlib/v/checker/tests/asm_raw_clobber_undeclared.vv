// A flag output's `@ccz` is not the fixed-register letter `c`.
fn raw_flag_output_does_not_bind_rcx() bool {
	mut z := false
	asm amd64 raw {
		"movq $1, %%rcx"
		; [z] "=@ccz" (z)
		;
		;
	}
	return z
}

fn raw_two_operand_imul_writes_its_destination(x u64) u64 {
	mut o := x
	asm amd64 raw {
		"imulq %[o], %%r14"
		; [o] "+r" (o)
		;
		; cc
	}
	return o
}

fn raw_write_before_the_save() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"movq $5, %%rbx\n"
		"pushq %%rbx\n"
		"movq %%rbx, %[out]\n"
		"popq %%rbx"
		; [out] "=d" (out)
		;
		;
	}
	return out
}

fn raw_write_after_the_restore() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"popq %%rbx\n"
		"movq $5, %%rbx\n"
		"movq %%rbx, %[out]"
		; [out] "=d" (out)
		;
		;
	}
	return out
}

fn raw_pop_of_another_register_restores_nothing() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"movq $5, %%rbx\n"
		"movq %%rbx, %[out]\n"
		"popq %%r12"
		; [out] "=r" (out)
		;
		;
	}
	return out
}

fn raw_push_without_pop_restores_nothing() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"movq $5, %%rbx\n"
		"movq %%rbx, %[out]"
		; [out] "=r" (out)
		;
		; cc
	}
	return out
}

fn raw_inner_push_is_not_the_saved_register() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"pushq %%r12\n"
		"movq $5, %%rbx\n"
		"movq %%rbx, %[out]\n"
		"popq %%rbx\n"
		"popq %%r12"
		; [out] "=r" (out)
		;
		;
	}
	return out
}

fn raw_flags_set_after_the_restore() u64 {
	mut out := u64(1)
	asm amd64 raw {
		"pushfq\n"
		"popfq\n"
		"addq $1, %[out]"
		; [out] "+r" (out)
		;
		;
	}
	return out
}

fn raw_operand_alias_named_like_a_register_saves_nothing(x u64) u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %[rbx]\n"
		"movq $5, %%rbx\n"
		"movq %%rbx, %[out]\n"
		"popq %[rbx]"
		; [out] "=r" (out)
		; [rbx] "r" (x)
		;
	}
	return out
}

fn raw_rep_on_its_own_statement(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rep; stosb"
		; [y] "+r" (y)
		; 
		; rdi memory
	}
	return y
}

fn raw_upper_case_rep_prefix(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"REP STOSB"
		; [y] "+r" (y)
		; 
		; rdi memory
	}
	return y
}

fn raw_upper_case_register_write(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"movq %[y], %%RBX"
		; [y] "+r" (y)
		; 
		; 
	}
	return y
}

fn raw_write_after_a_call(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"popq %%rbx\n\t"
		"call abort\n\t"
		"movq $1, %%rsi\n\t"
		"addq %%rsi, %[y]"
		; [y] "+b" (y)
		; 
		; rax rcx rdx rdi r8 r9 r10 r11 cc memory
	}
	return y
}

fn raw_write_beside_nested_frames(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"movq $1, %%r8\n\t"
		"leave\n\t"
		"leave"
		; [y] "+c" (y)
		; 
		; 
	}
	return y
}

fn raw_write_beside_a_frame_ended_by_mov_and_pop(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"pushq %%rbx\n\t"
		"movq $1, %%r8\n\t"
		"movq %%rbp, %%rsp\n\t"
		"popq %%rbp"
		; [y] "+c" (y)
		; 
		; 
	}
	return y
}

fn raw_rep_before_a_directive_that_emits_nothing(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rep\n\t"
		".globl raw_rep_symbol\n\t"
		"stosq"
		; [y] "+r" (y)
		; 
		; rdi memory
	}
	return y
}

