// Words, a prefix, and a label on its own line are still plain, and a fixed input does not
// declare any other register.
fn raw_label_and_prefix_keep_the_check(x u64) u64 {
	mut value := u64(0)
	asm amd64 raw {
		"1:\n\t"
		"lock addq $1, %%r15\n\t"
		"xorq %%r14, %%r14\n\t"
		"movq $42, %[value]"
		; [value] "=&d" (value)
		; [x] "c" (x)
		; cc
	}
	return value
}

// One mnemonic and one register view each, so that every family stays pinned.
fn raw_family_rbx(x u64) u64 {
	mut o := x
	asm amd64 raw {
		"movq $1, %%rbx"
		; [o] "+r" (o)
		;
		;
	}
	return o
}

