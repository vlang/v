fn raw_directive_after_the_write_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"xorq %%rcx, %%rcx\n\t"
		".previous\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
	return value
}

// A `@[_naked]` body is the whole function, so there is nothing around it to declare writes to.
@[_naked]
fn raw_naked_body_declares_nothing() {
	asm amd64 raw {
		"movl $42, %%eax\n\t"
		"xorl %%edx, %%edx\n\t"
		"ret"
	}
}

// These spellings can hide a directive or text that is not assembled, so they stop the check.
fn raw_byte_absorbs_next_line_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		".byte 0x3d\n\t"
		"xorl %%ebx, %%ebx\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
	return value
}

fn raw_dialect_alternative_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"{.pushsection .data|x}\n\t"
		"addq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
	return value
}

