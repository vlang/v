// A clobber given by number is not resolved, so the check says nothing about this block.
fn raw_numeric_clobber_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		; 0
	}
	return value
}

fn raw_numeric_clobber_after_comma_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		; rcx,0
	}
	return value
}

// A fixed input may be changed and restored, and a clobber of it does not compile.
fn raw_fixed_input_may_be_restored(x u64) u64 {
	mut value := u64(0)
	asm amd64 raw {
		"shlq $3, %%rcx\n\t"
		"leaq (%%rcx), %[value]\n\t"
		"shrq $3, %%rcx"
		; [value] "=&r" (value)
		; [x] "c" (x)
		; cc
	}
	return value
}

// A block with no sections is basic asm, which cannot declare anything, and its registers take
// one `%`.
fn raw_basic_asm_in_a_function() {
	asm amd64 raw {
		"addq $1, %rax"
	}
	asm amd64 raw {
		"mulq %rcx"
	}
}

fn raw_numeric_clobber_with_percent_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		; %0
	}
	return value
}

fn raw_numeric_clobber_with_hash_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		; #0
	}
	return value
}

// The branch after `|` is never assembled in AT&T syntax, and it can hide a statement.
fn raw_dialect_alternative_in_operands_stops_the_check() {
	asm amd64 raw {
		"nop {|;mulq %%rbx}"
		;
		;
		;
	}
}

// A constant's initializer has no function context, so this block is not checked.
const raw_const_closure = fn () u64 {
	mut x := u64(1)
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"addq $1, %[x]"
		; [x] "+r" (x)
		;
		;
	}
	return x
}

// Two-operand `imul` writes only its destination, and `rsp` is not checked.
fn raw_two_operand_imul_and_rsp(y u64) u64 {
	mut o := y
	asm amd64 raw {
		"imulq %[y], %[o]\n\t"
		"subq $8, %%rsp\n\t"
		"addq $8, %%rsp"
		; [o] "+r" (o)
		; [y] "r" (y)
		; cc
	}
	return o
}

// `b`, `S` and `D` bind their registers.
fn raw_fixed_register_letters(x u64) u64 {
	mut b := u64(0)
	mut s := u64(0)
	mut d := u64(0)
	asm amd64 raw {
		"movq %[x], %%rbx\n\t"
		"movq %[x], %%rsi\n\t"
		"movq %[x], %%rdi"
		; [b] "=b" (b)
		  [s] "=S" (s)
		  [d] "=D" (d)
		; [x] "r" (x)
		;
	}
	return b + s + d
}

// The `{` constraint names one register, and a narrower view counts as all of it.
fn raw_braced_constraint_and_register_view() u64 {
	mut v := u64(0)
	asm amd64 raw {
		"movl $1, %%r8d\n\t"
		"movq %%r8, %[v]"
		; [v] "={r8}" (v)
		;
		;
	}
	return v
}

// A `@[_naked]` body that ends without a return is not checked either.
@[_naked]
fn raw_naked_body_without_a_return() {
	asm amd64 raw {
		"movl $42, %%eax\n\t"
		"ud2"
		;
		;
		;
	}
}

// With sections too, a `@[_naked]` body is the whole function.
@[_naked]
fn raw_naked_body_with_sections() {
	asm amd64 raw {
		"movl $42, %%eax\n\t"
		"ret"
		;
		;
		;
	}
}

fn raw_save_and_restore() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"movq $5, %%rbx\n"
		"movq %%rbx, %[out]\n"
		"popq %%rbx"
		; [out] "=d" (out)
		;
		;
	}
	return out
}

fn raw_save_and_restore_implicit_write(x u64) u64 {
	mut out := u64(2)
	asm amd64 raw {
		"pushq %%rdx\n"
		"mulq %[x]\n"
		"popq %%rdx"
		; [out] "+a" (out)
		; [x] "c" (x)
		; cc
	}
	return out
}

fn raw_nested_save_and_restore() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"pushq %%r12\n"
		"movq $5, %%rbx\n"
		"movq $6, %%r12\n"
		"movq %%rbx, %[out]\n"
		"popq %%r12\n"
		"popq %%rbx"
		; [out] "=d" (out)
		;
		;
	}
	return out
}

fn raw_save_and_restore_around_another_push() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"pushq %%rbx\n"
		"pushq $1\n"
		"popq %[out]\n"
		"movq $5, %%rbx\n"
		"popq %%rbx"
		; [out] "=d" (out)
		;
		;
	}
	return out
}

fn raw_save_and_restore_flags() u64 {
	mut out := u64(1)
	asm amd64 raw {
		"pushfq\n"
		"addq $1, %[out]\n"
		"popfq"
		; [out] "+r" (out)
		;
		;
	}
	return out
}

fn raw_save_and_restore_on_i386(x u32) u32 {
	mut y := x
	asm i386 raw {
		"pushl %%ebx\n\t"
		"movl $1, %%ebx\n\t"
		"addl %%ebx, %[y]\n\t"
		"popl %%ebx\n\t"
		"pushfl\n\t"
		"incl %[y]\n\t"
		"popfl"
		; [y] "+c" (y)
		; 
		; cc
	}
	return y
}

fn raw_save_and_restore_unsuffixed(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushf\n\t"
		"push %%rbx\n\t"
		"mov $5, %%rbx\n\t"
		"add %%rbx, %[y]\n\t"
		"pop %%rbx\n\t"
		"popf"
		; [y] "+c" (y)
		; 
		; 
	}
	return y
}

fn raw_save_and_restore_upper_case(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"PUSHQ %%RBX\n\t"
		"movq $5, %%rbx\n\t"
		"movq %%rbx, %[y]\n\t"
		"POPQ %%Rbx"
		; [y] "+c" (y)
		; 
		; 
	}
	return y
}

fn raw_save_and_restore_around_stack_space(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"subq $16, %%rsp\n\t"
		"movq %[y], (%%rsp)\n\t"
		"movq (%%rsp), %%rbx\n\t"
		"movq %%rbx, %[y]\n\t"
		"addq $0x10, %%rsp\n\t"
		"popq %%rbx"
		; [y] "+r" (y)
		; 
		; cc memory
	}
	return y
}

fn raw_frame_restored_by_leave(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"subq $16, %%rsp\n\t"
		"movq %[y], -8(%%rbp)\n\t"
		"incq %[y]\n\t"
		"leave"
		; [y] "+r" (y)
		; 
		; cc memory
	}
	return y
}

fn raw_red_zone_store_below_the_save(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"movb $0, -1(%%rsp)\n\t"
		"movq $1, %%rbx\n\t"
		"addq %%rbx, %[y]\n\t"
		"popq %%rbx"
		; [y] "+r" (y)
		; 
		; cc memory
	}
	return y
}

fn raw_frame_restored_by_mov_and_pop(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"subq $16, %%rsp\n\t"
		"incq %[y]\n\t"
		"movq %%rbp, %%rsp\n\t"
		"popq %%rbp"
		; [y] "+r" (y)
		; 
		; cc
	}
	return y
}

fn raw_realigned_frame_restored_by_leave(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"andq $-16, %%rsp\n\t"
		"pushq %%rbx\n\t"
		"movq $1, %%rbx\n\t"
		"addq %%rbx, %[y]\n\t"
		"popq %%rbx\n\t"
		"leave"
		; [y] "+r" (y)
		; 
		; cc
	}
	return y
}

fn raw_release_past_the_realignment(x u64) u64 {
