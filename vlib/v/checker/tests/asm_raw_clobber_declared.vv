	mut value := u64(0)
	asm amd64 raw {
		".if 0\n\t"
		"xorq %%rax, %%rax\n\t"
		"xorq %%rcx, %%rcx\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
