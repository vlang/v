	println(raw_encoding_suffix_in_upper_case_is_not_checked(1))
	raw_rep_before_a_lone_wait_does_not_repeat_the_next_line()
	raw_rep_before_wait_movsb_does_not_repeat_it()
	raw_enterl_is_not_checked()
	raw_enterq_is_not_checked()
	raw_enterw_is_not_checked()
	raw_pusha_is_not_checked()
	raw_pushal_is_not_checked()
	raw_pushaw_is_not_checked()
	raw_popa_is_not_checked()
	raw_popal_is_not_checked()
	raw_popaw_is_not_checked()
	raw_call_to_the_location_counter_is_not_checked()
	raw_mov_rbp_to_rsp_outside_a_frame_is_not_checked()
	raw_addr32_on_its_own_line_is_not_a_repeat()
	raw_rep_reaches_only_the_instruction_it_prefixes()
}

// `rex.b movl $1, %%esi` writes `r14d`, not `esi`, so a REX prefix stops the check.
fn raw_rex_b_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rex.b movl $1, %%esi"
		; [y] "+r" (y)
		; 
		; r14
	}
	return y
}

// A `rex.b` on a line of its own prefixes the next instruction, which writes `r14d`.
fn raw_rex_b_on_a_line_of_its_own_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rex.b\n\t"
		"movl $1, %%esi"
		; [y] "+r" (y)
		; 
		; r14
	}
	return y
}

// `rex.b push %%rbx` pushes `r11`, so the `pop %%rbx` does not restore `rbx`.
fn raw_rex_b_push_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rex.b push %%rbx\n\t"
		"movl $1, %%ebx\n\t"
		"pop %%rbx"
		; [y] "+r" (y)
		; 
		; r11
	}
	return y
}

// `rex.w movl` assembles to a `movabs` that takes the bytes of the next instruction.
fn raw_rex_w_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rex.w movl $1, %%esi\n\t"
		"movl $2, %%edi"
		; [y] "+r" (y)
		; 
		; rsi
	}
	return y
}

// `rex64` is the GNU spelling of `rex.w`.
fn raw_rex64_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rex64 movl $1, %%esi\n\t"
		"movl $2, %%edi"
		; [y] "+r" (y)
		; 
		; rsi
	}
	return y
}

// With any REX prefix, `%%bh` encodes `dil`, so the move writes `rdi`.
fn raw_bare_rex_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rex movb $1, %%bh"
		; [y] "+r" (y)
		;
		; rdi
	}
	return y
}

// `rexz` is the GNU spelling of `rex.b`, so `rexz movl $1, %%esi` writes `r14d`, not `esi`.
fn raw_rexz_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"rexz movl $1, %%esi"
		; [y] "+r" (y)
		;
		; r14
	}
	return y
}

// The check reads past only `lock`, `wait` and the `rep` family, so a lone `addr32` stops it.
fn raw_lone_addr32_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"addr32\n\t"
		"movq $1, %%rsi"
		; [y] "+r" (y)
		;
		; cc
	}
	return y
}

// A lone `notrack` prefixes the next instruction, and the check does not read past it.
fn raw_lone_notrack_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"notrack\n\t"
		"movq $1, %%rsi"
		; [y] "+r" (y)
		;
		; cc
	}
	return y
}

// A lone `xacquire` prefixes the next instruction, and the check does not read past it.
fn raw_lone_xacquire_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"xacquire\n\t"
		"lock incq (%%rdi)"
		; [y] "+r" (y)
		;
		; memory
	}
	return y
}

// A lone `xrelease` prefixes the next instruction, and the check does not read past it.
fn raw_lone_xrelease_prefix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"xrelease\n\t"
		"movq $1, %%rsi"
		; [y] "+r" (y)
		;
		; cc
	}
	return y
}

// A `rep` on a line of its own before a `wait` prefixes the `fwait`, so the `movsb` after it is
// not repeated and does not write `rcx`.
fn raw_rep_before_a_lone_wait_does_not_repeat_the_next_line() {
	asm amd64 raw {
		"rep\n\t"
		"wait\n\t"
		"movsb"
		;
		;
		; rsi rdi memory
	}
}

// The same holds when the `wait` and the string instruction share a line.
fn raw_rep_before_wait_movsb_does_not_repeat_it() {
	asm amd64 raw {
		"rep\n\t"
		"wait movsb"
		;
		;
		; rsi rdi memory
	}
}

fn raw_enterl_is_not_checked() {
	asm i386 raw {
		"enterl $0, $0\n\t"
		"movl $1, %%eax"
		;
		;
		;
	}
}

fn raw_enterq_is_not_checked() {
	asm amd64 raw {
		"enterq $0, $0\n\t"
		"movq $1, %%rax"
		;
		;
		;
	}
}

fn raw_enterw_is_not_checked() {
	asm amd64 raw {
		"enterw $0, $0\n\t"
		"movq $1, %%rax"
		;
		;
		;
	}
}

fn raw_pusha_is_not_checked() {
	asm i386 raw {
		"pusha\n\t"
		"movl $1, %%eax"
		;
		;
		;
	}
}

fn raw_pushal_is_not_checked() {
	asm i386 raw {
		"pushal\n\t"
		"movl $1, %%eax"
		;
		;
		;
	}
}

fn raw_pushaw_is_not_checked() {
	asm i386 raw {
		"pushaw\n\t"
		"movl $1, %%eax"
		;
		;
		;
	}
}

fn raw_popa_is_not_checked() {
	asm i386 raw {
		"movl $1, %%eax\n\t"
		"popa"
		;
		;
		;
	}
}

fn raw_popal_is_not_checked() {
	asm i386 raw {
		"movl $1, %%eax\n\t"
		"popal"
		;
		;
		;
	}
}

fn raw_popaw_is_not_checked() {
	asm i386 raw {
		"movl $1, %%eax\n\t"
		"popaw"
		;
		;
		;
	}
}

fn raw_call_to_the_location_counter_is_not_checked() {
	asm amd64 raw {
		"call .\n\t"
		"movq $1, %%rax"
		;
		;
		;
	}
}

fn raw_mov_rbp_to_rsp_outside_a_frame_is_not_checked() {
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"movq %%rbp, %%rsp"
		;
		;
		;
	}
}

fn raw_addr32_on_its_own_line_is_not_a_repeat() {
	asm amd64 raw {
		"addr32\n\t"
		"stosb"
		;
		;
		; rdi memory
	}
}

fn raw_rep_reaches_only_the_instruction_it_prefixes() {
	asm amd64 raw {
		"pushq %%rcx\n\t"
		"rep movsb\n\t"
		"popq %%rcx\n\t"
		"stosb"
		;
		;
		; rsi rdi memory
	}
}

// An instruction between a lone `rep` and `movsb` takes the prefix, so `movsb` is not repeated.
fn raw_rep_then_nop_does_not_repeat_movsb() {
	asm amd64 raw {
		"rep\n\t"
		"nop\n\t"
		"movsb"
		;
		;
		; rsi rdi memory
	}
}

fn raw_rep_then_cld_does_not_repeat_movsb() {
	asm amd64 raw {
		"rep\n\t"
		"cld\n\t"
		"movsb"
		;
		;
		; rsi rdi memory
	}
}

// GNU as refuses a lone `rep wait`; clang's assembler puts the `rep` on the `fwait`.
fn raw_lone_rep_wait_does_not_repeat_movsb() {
	asm amd64 raw {
		"rep wait\n\t"
		"movsb"
		;
		;
		; rsi rdi memory
	}
}

// GNU as refuses a lone `lock rep`; clang's assembler drops the `rep`.
fn raw_lone_lock_rep_does_not_repeat_movsb() {
	asm amd64 raw {
		"lock rep\n\t"
		"movsb"
		;
		;
		; rsi rdi memory
	}
}

// GNU as refuses `rep lock movsb`; clang's assembler gives `rep` and `lock` no instruction.
fn raw_rep_lock_movsb_is_not_repeated() {
	asm amd64 raw {
		"rep lock movsb"
		;
		;
		; rsi rdi memory
	}
}

// The REX prefix after `wait` still stops the check: `rex.b movl $1, %%esi` writes `r14d`.
fn raw_wait_rex_b_prefix_is_not_checked() {
	asm amd64 raw {
		"wait rex.b movl $1, %%esi"
		;
		;
		; r14
	}
}

// The fill byte `0x41` is a REX prefix of the next instruction, which writes `r8d`, so an
// alignment directive with a fill stops the check.
fn raw_alignment_fill_stops_the_check() {
	asm amd64 raw {
		".balign 16\n\t"
		"nop\n\t"
		".p2align 1, 0x41\n\t"
		"movl $1, %%eax"
		;
		;
		; r8
	}
}

// `push %[w]` of a `u16` is a 16-bit push (GCC prints `push %di`), so the stack is not followed.
fn raw_push_of_a_16_bit_operand_is_not_checked(w u16) {
	asm amd64 raw {
		"push %%rbx\n\t"
		"push %[w]\n\t"
		"push %[w]\n\t"
		"push %[w]\n\t"
		"push %[w]\n\t"
		"pop %%rcx\n\t"
		"movq $1, %%rbx\n\t"
		"pop %%rbx"
		;
		; [w] "r" (w)
		; rcx
	}
}

struct RawPushField {
	x u16
}

// The register GCC picks for a field operand is not known to the check, so neither is the width
// of `push %[x]`.
fn raw_push_of_a_field_operand_is_not_checked(s RawPushField) {
	asm amd64 raw {
		"push %%rbx\n\t"
		"push %[x]\n\t"
		"push %[x]\n\t"
		"push %[x]\n\t"
		"push %[x]\n\t"
		"pop %%rcx\n\t"
		"movq $1, %%rbx\n\t"
		"pop %%rbx"
		;
		; [x] "r" (s.x)
		; rcx
	}
}

// A 64-bit operand pushed and popped around a write restores it.
fn raw_push_of_a_64_bit_operand_restores_it(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"push %[y]\n\t"
		"movq $1, %[y]\n\t"
		"pop %[y]"
		; [y] "+r" (y)
	}
	return y
}

// An output bound through a braced 32-bit name declares its register.
fn raw_braced_32_bit_output_declares_its_register() u32 {
	mut r := u32(0)
	asm amd64 raw {
		"movl $1, %%eax"
		; [r] "={eax}" (r)
	}
	return r
}

// An `A` output after another output still declares the whole pair.
fn raw_pair_output_after_another_output(x u64) u64 {
	mut a := u32(0)
	mut r := x
	asm x86 raw {
		"movl $1, %%eax\n\t"
		"movl $2, %%edx\n\t"
		"movl %%eax, %[a]"
		; [a] "=r" (a)
		  "=A" (r)
	}
	return r + a
}

// A memory operand based on the stack pointer stops the check, wherever the register sits.
fn raw_stack_address_with_an_index_is_not_checked() {
	asm amd64 raw {
		"movq %%rax, 8(%%rsp,%%rcx,8)\n\t"
		"movq $1, %%rbx"
		;
		;
		; memory
	}
}

fn raw_segment_stack_address_is_not_checked() {
	asm amd64 raw {
		"movq %%rax, %%fs:(%%rsp)\n\t"
		"movq $1, %%rbx"
		;
		;
		; memory
	}
}

fn raw_frame_pointer_as_an_index_in_a_frame_is_not_checked() {
	asm amd64 raw {
		"push %%rbp\n\t"
		"movq %%rsp, %%rbp\n\t"
		"movq %%rax, (%%rcx,%%rbp,1)\n\t"
		"movq $1, %%rbx\n\t"
		"leave"
		;
		;
		; memory
	}
}

// `%%ebp` names the frame pointer inside an i386 frame, so the check stops.
fn raw_i386_ebp_in_a_frame_is_not_checked() {
	asm i386 raw {
		"push %%ebp\n\t"
		"movl %%esp, %%ebp\n\t"
		"movl 8(%%ebp), %%esi\n\t"
		"leave"
		;
		;
		; memory
	}
}

// A call to either of two labels on one statement is a call into the template. The labels are
// exported plain names, as a `%=` target is never a plain symbol.
fn raw_call_to_the_first_of_two_labels_is_not_checked() {
	asm amd64 raw {
		".globl raw_two_labels_a1\n\t"
		".globl raw_two_labels_b1\n\t"
		"call raw_two_labels_a1\n\t"
		"raw_two_labels_a1: raw_two_labels_b1: nop\n\t"
		"movq $1, %%rbx"
		;
		;
		; memory
	}
}

fn raw_call_to_the_second_of_two_labels_is_not_checked() {
	asm amd64 raw {
		".globl raw_two_labels_a2\n\t"
		".globl raw_two_labels_b2\n\t"
		"call raw_two_labels_b2\n\t"
		"raw_two_labels_a2: raw_two_labels_b2: nop\n\t"
		"movq $1, %%rbx"
		;
		;
		; memory
	}
}

// An unread prefix after the first instruction still stops the check.
fn raw_unread_prefix_on_a_later_instruction_is_not_checked() {
	asm amd64 raw {
		"movq $1, %%rsi\n\t"
		"rex.b movl $1, %%esi"
		;
		;
		; r14
	}
}

// A numeric clobber stops the check wherever it is in the list.
fn raw_numeric_clobber_first_is_not_checked() {
	asm amd64 raw {
		"movq $1, %%rbx"
		;
		;
		; 0
		  memory
	}
}

// A flag output before another output declares the flags.
fn raw_flag_output_before_another_output(x u64) (bool, u64) {
	mut z := false
	mut r := x
	asm amd64 raw {
		"addq $1, %[r]"
		; [z] "=@ccz" (z)
		  [r] "+r" (r)
	}
	return z, r
}

// The template may write an input bound to a fixed register, which is not the first or the last.
fn raw_middle_fixed_input_is_not_reported(a u64, b u64, c u64) {
	asm amd64 raw {
		"movq $1, %%rsi"
		;
		; [a] "c" (a)
		  [b] "S" (b)
		  [c] "D" (c)
		; memory
	}
}

// `dword` is an unread prefix word.
fn raw_dword_prefix_is_not_checked() {
	asm amd64 raw {
		"dword nop\n\t"
		"movq $1, %%rbx"
		;
		;
		; memory
	}
}

// `bnd` is an unread prefix word.
fn raw_bnd_prefix_is_not_checked() {
	asm amd64 raw {
		"movq $1, %%rbx\n\t"
		"bnd nop"
		;
		;
		; memory
	}
}

// `.align` and `.balign` with a fill stop the check too.
fn raw_align_fill_stops_the_check() {
	asm amd64 raw {
		".balign 16\n\t"
		"nop\n\t"
		".align 2, 0x41\n\t"
		"movl $1, %%eax"
		;
		;
		; r8
	}
}

fn raw_balign_fill_stops_the_check() {
	asm amd64 raw {
		".balign 16\n\t"
		"nop\n\t"
		".balign 2, 0x41\n\t"
		"movl $1, %%eax"
		;
		;
		; r8
	}
}

// A `lock` on a line of its own reaches `rep movsb` too; `lock rep movsb` faults, and `rcx` is
// never written.
fn raw_lone_lock_before_rep_movsb_is_not_repeated() {
	asm amd64 raw {
		"lock\n\t"
		"rep movsb"
		;
		;
		; rsi rdi memory
	}
}

fn raw_lone_lock_and_lone_rep_before_movsb_are_not_repeated() {
	asm amd64 raw {
		"lock\n\t"
		"rep\n\t"
		"movsb"
		;
		;
		; rsi rdi memory
	}
}

fn raw_lone_rep_before_lock_movsb_is_not_repeated() {
	asm amd64 raw {
		"rep\n\t"
		"lock movsb"
		;
		;
		; rsi rdi memory
	}
}

// `dN` binds `rdx` although its register letter is not the last one.
fn raw_fixed_input_with_a_later_letter_is_not_reported(x u64) {
	asm amd64 raw {
		"movq $1, %%rdx"
		;
		; [x] "dN" (x)
		; memory
	}
}

// The undeclared-write check reads AT&T syntax only, so an Intel template is not checked.
fn raw_intel_template_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw intel {
		"add rax, 1"
		; [y] "+r" (y)
	}
	return y
}

// The undeclared-write check reads x86 templates only.
fn raw_arm64_template_is_not_checked(x u64) u64 {
	mut y := x
	asm arm64 raw {
		"add x0, x0, #1"
		; [y] "+r" (y)
	}
	return y
}

// A one-operand `imul` writes `rax` and `rdx`, not its operand.
fn raw_one_operand_imul_writes_the_pair_only() {
	asm amd64 raw {
		"imulq %%rcx"
		;
		;
		; rax rdx cc
	}
}

// A register copied whole with `mov` to another general-purpose register or to an operand, and later
// copied back from that place, is not reported, as in a frame pointer kept in a scratch register.
fn raw_frame_pointer_restored_with_mov_is_not_reported() u64 {
	mut result := u64(0)
	asm amd64 raw {
		"movq %%rbp, %%r11\n\t"
		".cfi_remember_state\n\t"
		".cfi_def_cfa_register r11\n\t"
		"movq $42, %%rbp\n\t"
		"movq %%rbp, %[result]\n\t"
		"movq %%r11, %%rbp\n\t"
		".cfi_restore_state"
		; [result] "=d" (result)
		;
		; r11
	}
	return result
}

fn raw_register_restored_from_an_operand_is_not_reported() u64 {
	mut slot := u64(0)
	mut result := u64(0)
	asm amd64 raw {
		"movq %%rbx, %[slot]\n\t"
		"movq $5, %%rbx\n\t"
		"movq %%rbx, %[result]\n\t"
		"movq %[slot], %%rbx"
		; [slot] "=c" (slot)
		  [result] "=d" (result)
	}
	return result
}

fn raw_i386_register_restored_with_mov_is_not_reported() u32 {
	mut result := u32(0)
	asm i386 raw {
		"movl %%ebx, %%esi\n\t"
		"movl $5, %%ebx\n\t"
		"movl %%ebx, %[result]\n\t"
		"movl %%esi, %%ebx"
		; [result] "=d" (result)
		;
		; esi
	}
	return result
}

// A register place is compared without regard to letter case.
fn raw_mov_place_register_in_two_cases_is_not_reported() {
	asm amd64 raw {
		"movq %%rbx, %%R11\n\t"
		"movq $5, %%rbx\n\t"
		"movq %%r11, %%rbx"
		;
		;
		; r11
	}
}

// An encoding suffix such as `.s` or `.d8` chooses the encoding as a pseudo prefix does, and a
// template that uses one is not checked: the plain `rbx` write after it is not reported, nor the
// flags.
fn raw_encoding_suffix_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"addq.s %%rax, %%rcx\n\t"
		"movq $5, %%rbx\n\t"
		"movq.d8 %%rbx, %[y]"
		; [y] "+r" (y)
	}
	return y
}

fn raw_encoding_suffix_in_upper_case_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"ADDQ.D32 %%rax, %%rcx\n\t"
		"addq %%rax, %%rbx\n\t"
		"movq %%rbx, %[y]"
		; [y] "+r" (y)
	}
	return y
}

// Operands bound to a fixed register, by letter or by a braced name, to a constant or to the flags
// cannot sit in the saved register, so the save and restore still keeps it.
fn raw_save_with_every_operand_pinned_is_not_reported(x u64) u64 {
	mut out := u64(0)
	mut zero := false
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"movq %[x], %%rbx\n\t"
		"addq %[k], %%rbx\n\t"
		"movq %%rbx, %[out]\n\t"
		"testq %%rbx, %%rbx\n\t"
		"popq %%rbx"
		; [out] "={rdx}" (out)
		  [zero] "=@ccz" (zero)
		; [x] "S" (x)
		  [k] "i" (3)
	}
	return if zero { 0 } else { out }
}

// An `A` operand can sit only in `rax` or `rdx`, so a save of another register still counts.
fn raw_save_of_rbx_beside_a_narrow_a_input_is_not_reported(v u32) u32 {
	mut out := u32(0)
	asm amd64 raw {
		"pushq %%rbx\n\t"
		"movq $5, %%rbx\n\t"
		"movl %[v], %[out]\n\t"
		"popq %%rbx"
		; [out] "=S" (out)
		; [v] "A" (v)
	}
	return out
}

// An `xchg` is a copy each way, so a second one gives `rbx` back; `r11` is in the clobbers.
fn raw_xchg_save_is_not_reported() u64 {
	mut out := u64(0)
	asm amd64 raw {
		"xchgq %%rbx, %%r11\n\t"
		"movq $7, %%rbx\n\t"
		"movq %%rbx, %[out]\n\t"
		"xchgq %%r11, %%rbx"
		; [out] "=d" (out)
		;
		; r11
	}
	return out
}

fn raw_xchg_copy_back_of_a_mov_save_is_not_reported() {
	asm amd64 raw {
		"movq %%rbx, %%r11\n\t"
		"movq $5, %%rbx\n\t"
		"xchgq %%r11, %%rbx"
		;
		;
		; r11
	}
}

fn raw_xchg_save_in_a_fixed_operand_is_not_reported() u64 {
	mut slot := u64(0)
	asm amd64 raw {
		"xchgq %%rbx, %[slot]\n\t"
		"movq $5, %%rbx\n\t"
		"xchgq %%rbx, %[slot]"
		; [slot] "+c" (slot)
	}
	return slot
}

fn raw_xchg_save_on_i386_is_not_reported() {
	asm i386 raw {
		"xchgl %%ebx, %%esi\n\t"
		"movl $5, %%ebx\n\t"
		"xchgl %%ebx, %%esi"
		;
		;
		; esi
	}
}

// Another mnemonic that starts like a checked one, and a `mov` to an operand named `rbp` after a
// `push` of `rbp`, which opens no frame but names the stack pointer, so nothing is reported.
fn raw_movsx_is_not_checked(x u8) u32 {
	mut y := u32(0)
	asm amd64 raw {
		"movsx %[x], %%ecx\n\t"
		"movl %%ecx, %[y]"
		; [y] "=d" (y)
		; [x] "a" (x)
	}
	return y
}

fn raw_mov_of_rsp_to_an_operand_named_rbp_is_not_checked() u64 {
	mut y := u64(0)
	asm amd64 raw {
		"pushq %%rbp\n\t"
		"movq %%rsp, %[rbp]\n\t"
		"movq $1, %%rbx\n\t"
		"popq %%rbp"
		; [rbp] "=c" (y)
		;
		; memory
	}
	return y
}

// An input that shares the register of an output may change.
fn raw_save_in_an_input_tied_to_an_output_is_not_reported(s u64) u64 {
	mut out := u64(0)
	asm amd64 raw {
		"movq %%rbx, %[s]\n\t"
		"movq $5, %%rbx\n\t"
		"movq %[s], %%rbx"
		; [out] "=c" (out)
		; [s] "0" (s)
	}
	return out
}

fn raw_user_interrupt_return_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"movq $1, %%r8\n\t"
		"uiret"
		; [y] "+r" (y)
		; 
		; 
	}
	return y
}

fn raw_fred_user_return_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"movq $1, %%r8\n\t"
		"eretu"
		; [y] "+r" (y)
		; 
		; 
	}
	return y
}

fn raw_fred_supervisor_return_is_not_checked(x u64) u64 {
	mut y := x
	asm amd64 raw {
		"movq $1, %%r8\n\t"
		"ERETS"
		; [y] "+r" (y)
		; 
		; 
	}
	return y
}
