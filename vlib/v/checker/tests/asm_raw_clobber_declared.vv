}

fn raw_slash_comment_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"nop // old; addq $1, %%rax\n\t"
		"addq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
	return value
}

fn raw_carriage_return_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"nop\r.pushsection .data\n\t"
		"addq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
	return value
}

fn raw_nul_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"nop \0\n\t"
		"addq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		;
	}
	return value
}

// A clobber given by number is not resolved, so the check says nothing about this block.
fn raw_numeric_clobber_stops_the_check() u64 {
	mut value := u64(0)
	asm amd64 raw {
		"movq $1, %%rax\n\t"
		"movq $42, %[value]"
		; [value] "=d" (value)
		;
		; 0
	}
	return value
}

// A fixed input may be changed and restored, and a clobber of it does not compile.
fn raw_fixed_input_may_be_restored(x u64) u64 {
	mut value := u64(0)
	asm amd64 raw {
		"shlq $3, %%rcx\n\t"
		"leaq (%%rcx), %[value]\n\t"
		"shrq $3, %%rcx"
		; [value] "=&r" (value)
		; [x] "c" (x)
		; cc
	}
	return value
}

fn main() {
	println(raw_writes_declared(1))
	println(raw_output_binds_rax(2))
	println(raw_reads_only(3))
	println(raw_byte_mul_writes_ax_only(4, 5))
	println(raw_repz_ret_does_not_write_rcx(6))
	println(raw_flag_output_declares_flags(1, 1))
	println(raw_byte_operand_mul_writes_ax_only(7, 5))
	println(raw_r10b_mul_writes_ax_only(7))
	println(C.raw_answer_declared())
	println(raw_positional_byte_mul_writes_ax_only(7, 5))
	println(raw_literal_positional_operand_is_not_width_checked())
	println(raw_flags_clobber_declares_flags(1))
	println(raw_intel_syntax_stops_the_check())
	println(raw_if_stops_the_check())
	println(raw_uppercase_if_stops_the_check())
	println(raw_ifdef_stops_the_check())
	println(raw_macro_stops_the_check())
	println(raw_rept_stops_the_check())
	println(raw_pushsection_stops_the_check())
	println(raw_section_stops_the_check())
	println(raw_text_stops_the_check())
	println(raw_data_stops_the_check())
	println(raw_symbol_assignment_stops_the_check())
	println(raw_code32_stops_the_check())
	println(raw_directive_after_the_write_stops_the_check())
	raw_naked_body_declares_nothing()
	println(raw_byte_absorbs_next_line_stops_the_check())
	println(raw_dialect_alternative_stops_the_check())
	println(raw_vex_prefix_stops_the_check())
	println(raw_unknown_label_form_stops_the_check())
	println(raw_symbol_assignment_mnemonic_stops_the_check())
	println(raw_assignment_without_blank_stops_the_check())
	println(raw_slash_comment_stops_the_check())
	println(raw_carriage_return_stops_the_check())
	println(raw_nul_stops_the_check())
	println(raw_numeric_clobber_stops_the_check())
	println(raw_fixed_input_may_be_restored(1))
	println(undefined_total)
}
