@[sendable]
struct SendablePoint {
	x int
}

@[sendable]
struct SendableBad {
	p &int
}

fn (p SendablePoint) double() int {
	return p.x * 2
}

fn (b SendableBad) zero() int {
	return 0
}

fn main() {
	p := SendablePoint{ x: 5 }
	h := spawn fn [p] () int {
		return p.x * 2
	}()
	println(h.wait())
	f := fn [p] () int {
		return p.x + 1
	}
	k := spawn f()
	println(k.wait())
	d := p.double
	j := spawn d()
	println(j.wait())
	e := f
	q := spawn e()
	println(q.wait())
	mut v := 7
	b := SendableBad{ p: &v }
	g := spawn fn [b] () int {
		return 0
	}()
	println(g.wait())
	g2 := fn [b] () int {
		return 0
	}
	w := spawn g2()
	println(w.wait())
	m := b.zero
	n := spawn m()
	println(n.wait())
	a := g2
	z := spawn a()
	println(z.wait())
}
