type Num = u8 | u16

fn (n Num) str() string {
	return match n {
		u8 { n.str() }
		else { n.str() }
	}
}

type Val = int | string

fn (v Val) str() string {
	return (v).str()
}

struct Foo {}

fn (f &Foo) str() string {
	return (*f).str()
}

struct Bar {}

fn (b &Bar) str() string {
	return (*(b)).str()
}

struct Baz {}

fn (z Baz) str() string {
	return (&z).str()
}

struct Qux {}

fn (q Qux) str() string {
	return (*(&q)).str()
}

type Alias = []int

fn (a Alias) str() string {
	return Alias(a).str()
}

struct MutSelf {
mut:
	x int
}

fn (mut m MutSelf) str() string {
	return m.str()
}

struct AliasedRecv {}

fn (f AliasedRecv) str() string {
	alias := f
	return alias.str()
}

interface Stringer {
	str() string
}

struct ViaIface {}

fn (f ViaIface) str() string {
	return Stringer(f).str()
}

struct MultiHop {}

fn (f MultiHop) str() string {
	a := f
	b := a
	return b.str()
}

fn main() {
	println(Num(u16(0)))
	println(Val(0))
	println(Foo{})
	println(Bar{})
	println(Baz{})
	println(Qux{})
	println(Alias([1]))
	mut ms := MutSelf{}
	println(ms)
	println(AliasedRecv{})
	println(ViaIface{})
	println(MultiHop{})
}
