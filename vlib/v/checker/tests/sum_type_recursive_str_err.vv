type Num = u8 | u16

fn (n Num) str() string {
	return match n {
		u8 { n.str() }
		else { n.str() }
	}
}

type Val = int | string

fn (v Val) str() string {
	return (v).str()
}

struct Foo {}

fn (f &Foo) str() string {
	return (*f).str()
}

struct Bar {}

fn (b &Bar) str() string {
	return (*(b)).str()
}

struct Baz {}

fn (z Baz) str() string {
	return (&z).str()
}

struct Qux {}

fn (q Qux) str() string {
	return (*(&q)).str()
}

type Alias = []int

fn (a Alias) str() string {
	return Alias(a).str()
}

struct MutSelf {
mut:
	x int
}

fn (mut m MutSelf) str() string {
	return m.str()
}

struct AliasedRecv {}

fn (f AliasedRecv) str() string {
	alias := f
	return alias.str()
}

interface Stringer {
	str() string
}

struct ViaIface {}

fn (f ViaIface) str() string {
	return Stringer(f).str()
}

struct MultiHop {}

fn (f MultiHop) str() string {
	a := f
	b := a
	return b.str()
}

struct ParenInit {}

fn (f ParenInit) str() string {
	alias := (f)
	return alias.str()
}

struct CondMut {
mut:
	remaining int
}

fn (n CondMut) str() string {
	mut next := n
	if n.remaining > 1 {
		next.remaining--
	}
	return next.str()
}

struct AddrAlias {}

fn (f AddrAlias) str() string {
	alias := &f
	return alias.str()
}

struct DerefAlias {}

fn (f &DerefAlias) str() string {
	alias := *f
	return alias.str()
}

struct UnsafeDirect {}

fn (f UnsafeDirect) str() string {
	return unsafe { f }.str()
}

struct UnsafeAlias {}

fn (f UnsafeAlias) str() string {
	alias := unsafe { f }
	return alias.str()
}

fn main() {
	println(Num(u16(0)))
	println(Val(0))
	println(Foo{})
	println(Bar{})
	println(Baz{})
	println(Qux{})
	println(Alias([1]))
	mut ms := MutSelf{}
	println(ms)
	println(AliasedRecv{})
	println(ViaIface{})
	println(MultiHop{})
	println(ParenInit{})
	println(CondMut{})
	println(AddrAlias{})
	println(DerefAlias{})
	println(UnsafeDirect{})
	println(UnsafeAlias{})
}
