// A parenthesis of a comment or of a literal is not syntax, so both of these
// are still one group wrapped in a redundant one.
fn main() {
	value := 3
	b := ((value /* ) */))
	c := ((value + ')'.len))
	d := ((value) /* explanation */)
	e := (/* leading */ (value))
	// An interpolation holds code, which may quote the same way the string
	// around it does: the `)` in it is inside the literal all the same.
	f := ((value + '${')'}'.len))
	println(b + c + d + e + f)
}
