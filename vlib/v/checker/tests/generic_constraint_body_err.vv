interface Named {
	name string
}

type Number = int | f64

fn members[T Named](a T) int {
	return a.age
}

fn remainder[T Number](x T, y T) T {
	return x % y
}

fn kind[T Number](x T) string {
	if x is f64 {
		return 'f64'
	}
	return 'int'
}

fn ages[T Named](xs []T) []int {
	return xs.map(it.age)
}

fn main() {}
