fn main() {
	for i in 4.0 .. 2 {
		println(i)
	}

	for i in int(4) .. 2.0 {
		println(i)
	}

	for i in 0 .. 1 << 99 {
		println(i)
	}

	// Do not fold a bound after checking it already reported an error.
	// The overflowed literal must not cause a second empty-range error.
	for i in 999999999999999999999999 .. 0 {
		println(i)
	}

	// Operator overloads cannot be evaluated as built-in arithmetic.
	for i in int(OverloadedRangeBound(2) + OverloadedRangeBound(2)) .. 1 {
		println(i)
	}

	// Signed right shifts preserve the sign bit.
	for i in unsafe { i64(-4) >> 1 } .. i64(0) {
		println(i)
	}

	// f32 precision applies at comptime function argument and return boundaries.
	for i in int(identity_f32(16777217.0)) .. 16777217 {
		println(i)
	}
	for i in int(return_f32()) .. 16777217 {
		println(i)
	}

	// Untyped integer arithmetic uses signed semantics.
	for i in 0 - 1 .. 0 {
		println(i)
	}

	// Do not evaluate the one overflowing signed division/modulo pair.
	for i in i64(min_i64) / i64(-1) .. 1 {
		println(i)
	}
	for i in i64(min_i64) % i64(-1) .. 1 {
		println(i)
	}

	// Unsigned powers keep the base unsigned when the exponent becomes negative.
	for i in u64(max_u64) ** u64(max_u64) .. 1 {
		println(i)
	}

	// Compare bounds after converting them to the induction variable type.
	for i in i64(256) .. u8(1) {
		println(i)
	}

	// Untyped power results are converted to runtime int width.
	for i in 65536 ** 2 .. 1 {
		println(i)
	}
}

type OverloadedRangeBound = u8

fn (a OverloadedRangeBound) + (b OverloadedRangeBound) OverloadedRangeBound {
	return a - b
}

@[comptime]
fn identity_f32(x f32) f32 {
	return x
}

@[comptime]
fn return_f32() f32 {
	return 16777217.0
}
