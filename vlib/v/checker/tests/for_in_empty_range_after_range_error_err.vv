fn main() {
	for i in 4.0 .. 2 {
		println(i)
	}

	for i in int(4) .. 2.0 {
		println(i)
	}

	for i in 0 .. 1 << 99 {
		println(i)
	}

	// Do not fold a bound after checking it already reported an error.
	// The overflowed literal must not cause a second empty-range error.
	for i in 999999999999999999999999 .. 0 {
		println(i)
	}

	// Operator overloads cannot be evaluated as built-in arithmetic.
	for i in int(OverloadedRangeBound(2) + OverloadedRangeBound(2)) .. 1 {
		println(i)
	}

	// Signed right shifts preserve the sign bit.
	for i in unsafe { i64(-4) >> 1 } .. i64(0) {
		println(i)
	}

	// f32 precision applies at comptime function argument and return boundaries.
	for i in int(identity_f32(16777217.0)) .. 16777217 {
		println(i)
	}
	for i in int(return_f32()) .. 16777217 {
		println(i)
	}

	// Untyped integer arithmetic uses signed semantics.
	for i in 0 - 1 .. 0 {
		println(i)
	}

	// Do not evaluate the one overflowing signed division/modulo pair.
	for i in i64(min_i64) / i64(-1) .. 1 {
		println(i)
	}
	for i in i64(min_i64) % i64(-1) .. 1 {
		println(i)
	}

	// Unsigned powers keep the base unsigned when the exponent becomes negative.
	for i in u64(max_u64) ** u64(max_u64) .. 1 {
		println(i)
	}

	// Compare bounds after converting them to the induction variable type.
	for i in i64(256) .. u8(1) {
		println(i)
	}

	// Untyped power results are converted to runtime int width.
	for i in 65536 ** 2 .. 1 {
		println(i)
	}

	// The high bound retains its comparison promotion instead of being truncated.
	for i in u8(250) .. 256 {
		println(i)
	}

	// Apply the usual signed/unsigned promotions to the comparison.
	for i in u32(4294967294) .. int(0 - 1) {
		println(i)
	}

	// Negative signed powers only preserve bases 1 and -1.
	for i in i64(max_i64) ** (0 - 1) .. 1 {
		println(i)
	}

	// Do not make diagnostics depend on the platform's powf result.
	for i in int(f32(5.01590028e28) ** f32(0.230928734)) .. 4243608 {
		println(i)
	}

	// Preserve the represented type of a wide integer literal during comparison.
	for i in 0 .. 4294967295 {
		println(i)
	}

	// Runes are represented as unsigned 32-bit integers.
	for i in rune(0) .. rune(-1) {
		println(i)
	}

	// Infer the represented type through composite literal expressions.
	for i in 0 .. 4294967294 + 1 {
		println(i)
	}

	// Preserve represented unsigned semantics when folding untyped u64 division.
	for i in 1 .. 18446744073709551615 / 2 {
		println(i)
	}
	for i in 1 .. i64(18446744073709551615 / 2) {
		println(i)
	}
	for i in 1 .. half_max_u64() {
		println(i)
	}

	// Apply represented widths after nested untyped subexpressions.
	for i in (4294967295 + 1) / 4294967295 .. 1 {
		println(i)
	}

	// Float-to-u64 casts saturate negative values to zero.
	for i in u64(-1.0) .. 1 {
		println(i)
	}

	// Floating-point powers depend on the target C math library.
	for i in int(f64(2.0) ** f64(2.0)) .. 4 {
		println(i)
	}

	// Do not guess the runtime width of an untyped comptime if expression.
	for _ in 0 .. ($if linux {
		4294967295
	} $else {
		1
	}) {
		break
	}
}

type OverloadedRangeBound = u8

fn (a OverloadedRangeBound) + (b OverloadedRangeBound) OverloadedRangeBound {
	return a - b
}

@[comptime]
fn identity_f32(x f32) f32 {
	return x
}

@[comptime]
fn return_f32() f32 {
	return 16777217.0
}

@[comptime]
fn half_max_u64() u64 {
	return 18446744073709551615 / 2
}
