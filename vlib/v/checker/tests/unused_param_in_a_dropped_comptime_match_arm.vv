// `parse_known_comptime_match_value` skips the arms of a `$match` that this
// build does not take, exactly as `parse_comptime_if` skips a branch, so an
// identifier used only there is invisible to the AST and must still count as
// used. What no arm mentions at all is still reported.
fn only_in_an_arm(w int) {
	$match @OS {
		'windows' {
			println(w)
		}
		$else {}
	}
}

// Several patterns share one body.
fn several_patterns(v int) {
	$match @OS {
		'windows', 'freebsd' {
			println(v)
		}
		$else {}
	}
}

// A `$if` nested in an arm, and an arm nested in a `$if`.
fn nested_both_ways(u int) {
	$match @OS {
		'windows' {
			$if amd64 {
				println(u)
			} $else {
				println(u)
			}
		}
		$else {}
	}
}

fn never_mentioned(p int) {
	$match @OS {
		'windows' {
			println('w')
		}
		$else {}
	}
}

fn main() {
	never_mentioned(2)
	nested_both_ways(5)
	several_patterns(6)
	only_in_an_arm(7)
}
