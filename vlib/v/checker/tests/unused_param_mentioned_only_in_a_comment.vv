// Only the `$if` branches of a function can hide a use from the checker, so a
// name that merely appears in a comment or in a string stays unused.
fn commented(x int) {
	/* x */
	$if windows {
	}
}

fn quoted(y int) {
	// y
	$if windows {
		println('y')
	}
}

fn interpolated(z int) {
	$if windows {
		println('${z}')
	}
}

// `r` prefixes the literal here, it is not a name of its own.
fn raw_prefixed(r string) {
	$if windows {
		println(r'raw')
	}
}

fn lookup(k string) int {
	return k.len
}

// The nested `'n'` is a literal, even though it sits in an interpolation.
fn interpolated_literal(n string) {
	$if windows {
		println('${lookup('n')}')
	}
}

// A C string is never interpolated, so `${cs}` is plain text in it too.
fn c_string_literal(cs string) {
	$if windows {
		_ = c'${cs}'
	}
}

// `$if fl ?` tests a compile-time flag, it does not read the parameter.
fn comptime_flag(fl int) {
	$if windows {
		$if fl ? {
			println('on')
		}
	}
}

// `$env` is a compile-time function, not a read of the parameter.
fn comptime_function(env string) {
	$if windows {
		_ = $env('PATH')
	}
}

// The instructions of an `asm` block are raw text, so a register spelled like
// the parameter is not a read of it. `$if v_asm_probe ?` is never defined, so
// the block is dropped on every target and assembled on none.
fn asm_register_name(x0 int) {
	$if v_asm_probe ? {
		asm arm64 {
			mov x0, x1
		}
	}
}

fn main() {
	asm_register_name(6)
	comptime_function('f')
	comptime_flag(5)
	c_string_literal('d')
	commented(1)
	quoted(2)
	interpolated(3)
	raw_prefixed('a')
	interpolated_literal('b')
	println(lookup('c'))
}
