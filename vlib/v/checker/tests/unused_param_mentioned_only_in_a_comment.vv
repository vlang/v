// Only the `$if` branches of a function can hide a use from the checker, so a
// name that merely appears in a comment or in a string stays unused.
fn commented(x int) {
	/* x */
	$if windows {
	}
}

fn quoted(y int) {
	// y
	$if windows {
		println('y')
	}
}

fn interpolated(z int) {
	$if windows {
		println('${z}')
	}
}

// `r` prefixes the literal here, it is not a name of its own.
fn raw_prefixed(r string) {
	$if windows {
		println(r'raw')
	}
}

fn lookup(k string) int {
	return k.len
}

// The nested `'n'` is a literal, even though it sits in an interpolation.
fn interpolated_literal(n string) {
	$if windows {
		println('${lookup('n')}')
	}
}

// A C string is never interpolated, so `${cs}` is plain text in it too.
fn c_string_literal(cs string) {
	$if windows {
		_ = c'${cs}'
	}
}

// `$if fl ?` tests a compile-time flag, it does not read the parameter.
fn comptime_flag(fl int) {
	$if windows {
		$if fl ? {
			println('on')
		}
	}
}

// `$env` is a compile-time function, not a read of the parameter.
fn comptime_function(env string) {
	$if windows {
		_ = $env('PATH')
	}
}

// The instructions of an `asm` block are raw text, so a register spelled like
// the parameter is not a read of it. `$if v_asm_probe ?` is never defined, so
// the block is dropped on every target and assembled on none.
fn asm_register_name(x0 int) {
	$if v_asm_probe ? {
		asm arm64 {
			mov x0, x1
		}
	}
}

// `goto lbl` and the `lbl:` it jumps to name a label, not a variable.
fn goto_label(lbl int) {
	$if windows {
		unsafe {
			goto lbl
		}
		lbl:
		println('done')
	}
}

// The `:x` of an interpolation is a format, not a name.
fn interpolation_format(x int) {
	$if windows {
		value := 255
		println('${value:x}')
	}
}

fn always() bool {
	return true
}

// A label may sit in a block nested inside the branch.
fn nested_label(nl int) {
	$if windows {
		if always() {
			unsafe {
				goto nl
			}
			nl:
			println('done')
		}
	}
}

// The condition of the block may end in a literal.
fn literal_condition(lc int) {
	$if windows {
		n := 2
		if n == 1 {
			unsafe {
				goto lc
			}
			lc:
			println('done')
		}
	}
}

fn get_bool() !bool {
	return true
}

// A propagated condition ends before the block it opens.
fn propagated_condition(pc int) ! {
	$if windows {
		if get_bool()! {
			mut n := 0
			pc: n++
			if n < 3 {
				unsafe {
					goto pc
				}
			}
			println(n)
		}
	}
}

// `chan` is not reserved, so it may name a parameter, and `chan int{}` still
// names a type. `$if v_chan_probe ?` is never defined, so the branch is dropped
// on every target and compiled on none.
fn channel_type_marker(chan int) {
	$if v_chan_probe ? {
		c := chan int{}
		println(c.cap)
	}
}

// A `{` follows a condition too, so `if chan {` reads the parameter.
fn channel_condition(chan bool) {
	$if windows {
		if chan {
			println('on')
		}
	}
}

// An operator keyword reads the parameter rather than naming a type after it.
fn channel_membership(chan int) {
	$if windows {
		allowed := [1, 2]
		if chan in allowed {
			println('on')
		}
	}
}

fn main() {
	channel_membership(3)
	channel_condition(true)
	channel_type_marker(12)
	propagated_condition(11) or { println('e') }
	_ = get_bool() or { false }
	literal_condition(10)
	interpolation_format(8)
	nested_label(9)
	println(always())
	goto_label(7)
	asm_register_name(6)
	comptime_function('f')
	comptime_flag(5)
	c_string_literal('d')
	commented(1)
	quoted(2)
	interpolated(3)
	raw_prefixed('a')
	interpolated_literal('b')
	println(lookup('c'))
}
