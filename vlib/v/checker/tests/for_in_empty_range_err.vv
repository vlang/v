	for i in u64(2) + u32(2) .. 2 {
		println(i)
	}

	for i in u64(2) + u64(2) .. 2 {
		println(i)
	}

	for i in u64(2) + i64(2) .. 2 {
		println(i)
	}

	// ? -----------i8---------------

	for i in i8(2) + i8(2) .. 2 {
		println(i)
	}

	for i in i8(2) + i16(2) .. 2 {
		println(i)
	}

	for i in i8(2) + i32(2) .. 2 {
		println(i)
	}

	for i in i8(2) + i64(2) .. 2 {
		println(i)
	}

	// ? -----------i16---------------

	for i in i16(2) + u8(2) .. 2 {
		println(i)
	}

	for i in i16(2) + i8(2) .. 2 {
		println(i)
	}

	for i in i16(2) + i16(2) .. 2 {
		println(i)
	}

	for i in i16(2) + i32(2) .. 2 {
		println(i)
	}

	for i in i16(2) + i64(2) .. 2 {
		println(i)
