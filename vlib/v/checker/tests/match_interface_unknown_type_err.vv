interface Value {}

struct Box[T] {
	val T
}

struct Holder {
	val Value
}

fn main() {
	s := Holder{
		val: 42
	}

	match s.val {
		Missing {}
		Missing[int] {}
		Missing[Box] {}
		Box[Missing] {}
		Box[[]Missing] {}
		Box[map[string]Missing] {}
		Box[map[Missing]string] {}
		Box[fn (Missing) int] {}
		Box[fn (int) Missing] {}
		else {}
	}
}
