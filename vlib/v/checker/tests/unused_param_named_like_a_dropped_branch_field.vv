// Spelling a name is not referencing it: a `$if` branch this build drops can
// mention it as a field label or as a member of something else and still leave
// the parameter unused.
struct Config {
	x int
	y int
}

fn field_label(x int) {
	$if windows {
		_ = Config{
			x: 1
		}
	}
}

fn member(y int) {
	$if windows {
		cfg := Config{}
		_ = cfg.y
	}
}

fn referenced(w int) {
	$if windows {
		println(w)
	}
}

fn configure(cfg Config) int {
	return cfg.x
}

// The short struct argument of a call names a field, it does not read one.
fn short_struct_argument(x int) {
	$if windows {
		configure(x: 1)
	}
}

fn make_handler() fn (Config) int {
	return configure
}

// The callee may be an expression rather than a name.
fn dynamic_callee(y int) {
	$if windows {
		_ = make_handler()(y: 1)
	}
}

fn handlers() [][]fn (Config) int {
	return [[configure]]
}

// The callee may be indexed more than once before it is called.
fn chained_index_callee(y int) {
	$if windows {
		hs := handlers()
		_ = hs[0][0](y: 1)
	}
}

fn main() {
	chained_index_callee(8)
	println(handlers()[0][0](x: 9))
	dynamic_callee(6)
	println(make_handler()(x: 7))
	short_struct_argument(4)
	println(configure(x: 5))
	field_label(1)
	member(2)
	referenced(3)
}
