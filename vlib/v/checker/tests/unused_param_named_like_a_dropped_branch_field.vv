// Spelling a name is not referencing it: a `$if` branch this build drops can
// mention it as a field label or as a member of something else and still leave
// the parameter unused.
struct Config {
	x int
	y int
}

fn field_label(x int) {
	$if windows {
		_ = Config{
			x: 1
		}
	}
}

fn member(y int) {
	$if windows {
		cfg := Config{}
		_ = cfg.y
	}
}

fn referenced(w int) {
	$if windows {
		println(w)
	}
}

fn configure(cfg Config) int {
	return cfg.x
}

// The short struct argument of a call names a field, it does not read one.
fn short_struct_argument(x int) {
	$if windows {
		configure(x: 1)
	}
}

fn main() {
	short_struct_argument(4)
	println(configure(x: 5))
	field_label(1)
	member(2)
	referenced(3)
}
