// `$if prealloc` is not taken by this build, so its body is never parsed. The
// parameter and the variable it uses must still count as used.
fn arena_leave(arena voidptr) {
	$if prealloc {
		if arena != unsafe { nil } {
			unsafe { prealloc_scope_leave(arena) }
		}
	}
}

struct Counter {
	n int
}

// An operator overload has a body of its own, parsed apart from `fn_decl_body`,
// and a branch dropped inside it hides a use just the same.
fn (a Counter) + (b Counter) Counter {
	$if prealloc {
		return b
	}
	return a
}

// `module` is tokenized as a keyword, but it is legal as a parameter name.
fn keyword_shaped_ident(module string) {
	$if prealloc {
		println(module)
	}
}

// A name before a colon is an expression in a map key or string interpolation,
// rather than a struct-field or named-argument label.
fn colon_delimited_ident(key string, width int) {
	$if prealloc {
		_ := map[string]int{
			key: 1
		}
		println('${width:4}')
	}
}

fn infix_bare_map_key(key int) {
	$if prealloc {
		_ := 1 in {
			key: 'one'
		}
	}
}

fn maybe_number() ?int {
	return none
}

fn braced_asm_operand(input int) {
	$if prealloc {
		asm arm64 {
			mov x0, x1
			; ; r (maybe_number() or { input })
		}
	}
}

fn main() {
	println((Counter{1} + Counter{2}).n)
	keyword_shaped_ident('v')
	colon_delimited_ident('answer', 42)
	infix_bare_map_key(1)
	braced_asm_operand(42)
	_ = maybe_number()
	// A capture used only in the dropped closure branch is still used.
	captured := 64
	only_in_skipped_branch := fn [captured] () {
		$if prealloc {
			println(captured)
		}
	}
	only_in_skipped_branch()
	// A captured assignment is still an identifier occurrence even though it is
	// not a read for local-variable diagnostics.
	mut assigned_capture := 0
	assigned_in_skipped_branch := fn [mut assigned_capture] () {
		$if prealloc {
			assigned_capture = 1
		}
	}
	assigned_in_skipped_branch()
	// Parsing the literal above must restore the enclosing function's offset.
	limit := 32
	$if prealloc {
		println(limit)
	}
	arena_leave(unsafe { nil })
	nested_arena_leave(unsafe { nil })
}

// The dropped branch may sit inside a branch that is taken.
fn nested_arena_leave(arena voidptr) {
	$if true {
		$if prealloc {
			unsafe { prealloc_scope_leave(arena) }
		}
	}
}
