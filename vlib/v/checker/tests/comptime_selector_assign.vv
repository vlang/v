// A comptime field selector needs a type guard before assigning an int.

struct Income {
mut:
	email string
	code  int
}

pub fn structuring[T](res_map map[string]int) T {
	mut typ := T{}
	// Populate fields whose names occur in the map.

	$for field in T.fields {
		if field.name in res_map {
			$if field.typ is int {
				typ.$(field.name) = 2
			}
			typ.$(field.name) = 3
		}
	}
	return typ
}

fn main() {
	structuring[Income]({'email': 1, 'code': 12})
}
