import db.sqlite

struct InsertOnlyUser {
	id      int    @[primary]
	creator string @[immutable]
	name    string
}

fn main() {
	db := sqlite.connect(':memory:')!
	enabled := true
	sql db {
		dynamic update InsertOnlyUser set {
			if enabled {
				creator == 'other'
			}
		} where id == 1
	}!
	assignments := {
		creator == 'other'
	}
	sql db {
		dynamic update InsertOnlyUser set assignments where id == 1
	}!
}
