// The parameter of a `|x| x + 1` lambda is a binding of its own, so a dropped
// `$if` branch that only uses it there leaves the outer variable unused - the
// same answer the AST gives on the target that takes the branch.
// A `;` ends the lambda, so what follows reads the outer name again.
fn after_a_semicolon() {
	s := 1
	$if windows {
		cb := |s| s + 1; println(s)
		_ = cb
	}
}

// The body may also be left for the next line.
fn on_the_next_line() {
	t := 1
	$if windows {
		cb := |t|
			t + 1
		_ = cb
	}
}

// A bare body may also continue after a trailing operator.
fn continued_after_an_operator() {
	u := 1
	$if windows {
		cb := |u| 1 +
			u
		_ = cb
	}
}

// A body that is only a literal leaves no code behind, but still ends the
// lambda: the `println` below reads the outer `v`.
fn literal_body() {
	v := 1
	$if windows {
		cb := |v| 'constant'
		println(v)
		_ = cb
	}
}

// `unsafe` takes the block that follows it, so the body does not end with the
// line: the `w` in the block belongs to the lambda.
fn keyword_led_body() {
	w := 1
	$if windows {
		cb := |w| unsafe
		{ w }
		_ = cb
	}
}

struct Selector {
	type string
}

// A keyword after a `.` names a field, and ends the line like any other one.
fn keyword_field_body() {
	s := 1
	sel := Selector{
		type: 'a'
	}
	$if windows {
		cb := |s| sel.type
		println(s)
		_ = cb
	}
	_ = sel
}

struct Maker {
	n int
}

fn (m Maker) consume(v int) int {
	return m.n + v
}

fn make_maker() Maker {
	return Maker{
		n: 1
	}
}

// A `.method()` on the next line continues the body.
fn chained_body() {
	c := 1
	$if windows {
		cb := |c| make_maker()
			.consume(c)
		_ = cb
	}
}

fn truthy() bool {
	return true
}

// The parser consumes the newline between a `}` and the `else` that continues
// the control-flow expression it closes, so the `else` body still belongs to
// the lambda.
fn newline_before_else() {
	e := 1
	$if windows {
		cb := |e| if truthy() { 1 }
		else { e }
		_ = cb
	}
}

// A `{` written on its own line opens the block of the condition before it,
// and needs the same newline consumed.
fn newline_before_a_block() {
	f := 1
	$if windows {
		cb := |f| if truthy()
		{ f } else { 0 }
		_ = cb
	}
}

fn twice(n int) int {
	return n * 2
}

// The parser joins a `(` on the next line only when a name or a selector
// stands before it and the call is indented deeper, so this group belongs to
// the lambda and its `g` is the parameter.
fn a_deeper_newline_call() {
	g := 1
	$if windows {
		cb := |g| twice
			(g)
		_ = cb
	}
}

// Written at the same depth it is a statement of its own, and the name in it
// reads what encloses the lambda: `h` is used here.
fn a_group_at_the_same_depth() {
	h := 1
	$if windows {
		cb := |h| h + 1
		(h).str()
		_ = cb
	}
}

enum Key {
	a
	b
}

// `.name:` on the next line opens the next entry of an enum-keyed map, so the
// first lambda ends there and what the second entry spells reads the outer
// binding: `n` is used here.
fn enum_keyed_entries() {
	n := 1
	$if windows {
		m := {
			Key.a: |n| n + 1
			.b:    |o| o + n
		}
		println(m.len)
	}
}

// The parser consumes the newline before an infix operator, so the body goes
// on over one.
fn leading_infix() {
	i := true
	$if windows {
		cb := |i| true
		|| i
		_ = cb
	}
}

// Except `+` and `-`, which continue only when indented deeper than the line
// the expression starts on.
fn deeper_plus() {
	d := 1
	$if windows {
		cb := |d| 1
			+ d
		_ = cb
	}
}

fn main() {
	deeper_plus()
	leading_infix()
	enum_keyed_entries()
	println(twice(1))
	a_group_at_the_same_depth()
	a_deeper_newline_call()
	assert truthy()
	newline_before_a_block()
	newline_before_else()
	chained_body()
	println(make_maker().consume(1))
	keyword_field_body()
	keyword_led_body()
	literal_body()
	continued_after_an_operator()
	on_the_next_line()
	after_a_semicolon()
	q := 1
	$if windows {
		cb := |q| q + 1
		r := cb(2)
		assert r == 3
	}
}
