fn intel_sub(a int, b int) int {
	mut res := 0
	asm amd64 intel {
		mov eax, a
		mov res, eax
		; +r (res)
		; r (a)
		  r (b)
	}
	return res
}

fn intel_shift(value int) int {
	mut result := value
	asm amd64 intel {
		sar result, 1
		; +r (result)
	}
	return result
}

fn intel_literal() {
	asm amd64 intel {
		mov rax, one
		; ; r (1) as one
	}
}

fn intel_hard_register(value i64) {
	asm amd64 intel {
		mov eax, value
		; ; r (value)
	}
}

fn intel_uppercase_hard_register(value i64) {
	asm amd64 intel {
		MOV eax, value
		; ; r (value)
	}
}

fn main() {
	println(intel_sub(50, 8))
}
