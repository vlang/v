enum IntelNarrow as u8 {
	value
}

fn intel_sub(a int, b int) int {
	mut res := 0
	asm amd64 intel {
		mov eax, a
		mov res, eax
		; +r (res)
		; r (a)
		  r (b)
	}
	return res
}

fn intel_shift(value int) int {
	mut result := value
	asm amd64 intel {
		sar result, 1
		; +r (result)
	}
	return result
}

fn intel_literal() {
	asm amd64 intel {
		mov rax, one
		; ; r (1) as one
	}
}

fn intel_hard_register(value i64) {
	asm amd64 intel {
		mov eax, value
		; ; r (value)
	}
}

fn intel_uppercase_hard_register(value i64) {
	asm amd64 intel {
		MOV eax, value
		; ; r (value)
	}
}

fn intel_bit_test_hard_register(index i64) {
	asm amd64 intel {
		bt eax, index
		; ; r (index)
	}
}

fn intel_double_shift_hard_register(value i64) {
	asm amd64 intel {
		shld eax, value, 1
		; ; r (value)
	}
}

fn intel_bmi_hard_register(left i64, right i64) {
	asm amd64 intel {
		andn eax, left, right
		; ; r (left)
		  r (right)
	}
}

fn intel_narrow_enum(value IntelNarrow) {
	asm amd64 intel {
		mov rax, value
		; ; r (value)
	}
}

fn intel_encoding_prefix_hard_register(value i64) {
	asm amd64 intel {
		rex add eax, value
		; ; r (value)
	}
}

fn intel_size_suffix_hard_register(value i64) {
	asm amd64 intel {
		addq eax, value
		; ; r (value)
	}
}

fn intel_narrow_size_suffix(value i64) {
	asm amd64 intel {
		addl rax, value
		; ; r (value)
	}
}

fn intel_crc32_hard_register(value i64) {
	asm amd64 intel {
		crc32 eax, value
		; ; r (value)
	}
}

fn intel_address_hard_register(base i64) {
	asm amd64 intel {
		mov rax, [eax * 4 + base]
		; ; r (base)
	}
}

fn intel_crc32_dword_source(checksum i64) {
	mut result := checksum
	asm amd64 intel {
		crc32 result, eax
		; +r (result)
		; ; rax
	}
}

fn intel_double_shift_bad_count(value i64) {
	mut result := value
	asm amd64 intel {
		shld result, value, eax
		; +r (result)
		; r (value)
		; rax
	}
}

fn intel_cmov_size_suffix(value i64) {
	asm amd64 intel {
		cmovzl rax, value
		; ; r (value)
	}
}

fn intel_address_hard_displacement(base i64) {
	asm amd64 intel {
		mov rax, [base * 4 + eax]
		; ; r (base)
	}
}

fn main() {
	println(intel_sub(50, 8))
}
