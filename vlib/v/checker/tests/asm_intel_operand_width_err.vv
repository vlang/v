fn intel_sub(a int, b int) int {
	mut res := 0
	asm amd64 intel {
		mov eax, a
		mov res, eax
		; +r (res)
		; r (a)
		  r (b)
	}
	return res
}

fn intel_shift(value int) int {
	mut result := value
	asm amd64 intel {
		sar result, 1
		; +r (result)
	}
	return result
}

fn main() {
	println(intel_sub(50, 8))
}
