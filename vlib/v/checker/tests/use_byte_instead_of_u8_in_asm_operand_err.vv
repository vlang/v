fn main() {
	x := u8(1)
	mut buf := [u8(0), 0]
	mut result := 0
	asm amd64 {
		.byte 0x90
		mov result, y
		; =r (result)
		  =r (buf[byte(0)])
		; r (byte(x)) as y
	}
	// An operand can hold another asm statement, whose text is exempt again, while
	// the rest of the operand is still V code.
	asm amd64 {
		mov result, z
		; =r (result)
		; r (if x > 0 {
			asm amd64 {
				.byte 0x91
			}
			int(byte(7))
		} else {
			0
		}) as z
	}
	println('${result} ${buf}')
}
