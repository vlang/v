// A dropped `$if` branch has to be read the way the AST reads a taken one: the
// `x` of a generic `Box[int]{x: 1}` only labels a field, and a `|x| x + 1` used
// as a struct field value still binds its own parameter.
struct Box[T] {
	x T
}

struct S {
	cb fn (int) int = unsafe { nil }
}

fn generic_field_label(x int) {
	$if windows {
		_ = Box[int]{
			x: 1
		}
	}
}

fn lambda_after_a_colon() {
	p := 1
	$if windows {
		s := S{
			cb: |p| p + 1
		}
		r := s.cb(2)
		assert r == 3
	}
}

fn main() {
	generic_field_label(1)
	lambda_after_a_colon()
}
