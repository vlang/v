// A dropped `$if` branch has to be read the way the AST reads a taken one: the
// key of a map literal is an expression that references the name, while a plain
// assignment writes to it without reading it.
fn map_key(k string) {
	$if windows {
		m := {
			k: 1
		}
		println(m)
	}
}

fn write_only() {
	mut w := 0
	$if windows {
		w = 1
	}
}

// A map literal may be returned directly, where a keyword precedes its brace.
fn returned_map_key(r string) map[string]int {
	$if windows {
		return {
			r: 1
		}
	} $else {
		return {}
	}
}

// Only the first target of a multi-assignment is written without being read.
fn pair() (int, int) {
	return 1, 2
}

fn multi_assign() {
	mut first := 0
	mut second := 0
	$if windows {
		first, second = pair()
	} $else {
		_, second = pair()
	}
	println(second)
}

// A typed map literal holds key expressions too.
fn typed_map_key(tk string) {
	$if windows {
		m := map[string]int{
			tk: 1
		}
		println(m)
	}
}

fn double(n int) int {
	return n * 2
}

// A function-valued map type ends in punctuation, and is still a map.
fn function_valued_map_key(fk string) {
	$if windows {
		m := map[string]fn (int) int{
			fk: double
		}
		println(m.len)
	}
}

// A statement label keeps its assignment on the same line, and the assignment
// still only writes.
fn labeled_assignment() {
	mut lv := 0
	$if windows {
		mut n := 0
		retry: lv = 1
		n++
		if n < 3 {
			unsafe {
				goto retry
			}
		}
		println(n)
	}
}

// The literal may be addressed, and is a map all the same.
fn addressed_map_key(ak string) {
	$if windows {
		m := &map[string]int{
			ak: 1
		}
		println(m.len)
	}
}

// The value type may be an anonymous struct, whose braces belong to it.
fn anonymous_value_type_key(nk string) {
	$if windows {
		m := map[string]struct {
			n int
		}{
			nk: struct {
				n: 1
			}
		}
		println(m.len)
	}
}

// `assert`, `if` and `match` all want an expression before their block, so a
// brace standing directly after one opens a map and keys it with code.
fn asserted_map_key(sk string) {
	$if windows {
		assert {
			sk: 1
		}.len == 1
	}
}

fn condition_map_key(ck string) {
	$if windows {
		if {
			ck: 1
		}.len == 1 {
			println('one')
		}
	}
}

fn matched_map_key(mk string) {
	$if windows {
		match {
			mk: 1
		}.len {
			1 { println('one') }
			else { println('other') }
		}
	}
}

// A condition before the brace still opens a block, and the `name:` of one
// labels a statement rather than keying a map, so the parameter it is spelled
// like stays unused.
fn condition_block(bk int) {
	$if windows {
		if double(1) > 0 {
			bk: for i := 0; i < 2; i++ {
				break bk
			}
		}
	}
}

fn main() {
	condition_block(9)
	matched_map_key('l')
	condition_map_key('k')
	asserted_map_key('j')
	anonymous_value_type_key('i')
	addressed_map_key('h')
	labeled_assignment()
	function_valued_map_key('g')
	println(double(2))
	typed_map_key('e')
	map_key('a')
	write_only()
	multi_assign()
	println(returned_map_key('c'))
}
