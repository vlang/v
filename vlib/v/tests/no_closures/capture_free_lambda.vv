// Lambdas that do not capture locals are lowered to plain functions, so
// `-no-closures` accepts them like the equivalent `fn () {}` literals.
const factor = 3

struct Handler {
	cb fn (int) int = |x| x + factor
}

fn call(cb fn ()) {
	cb()
}

type Ints = []int

fn apply(f fn (int) int, v int) int {
	return f(v)
}

fn lens(f fn ([]int) int, v []int) int {
	return f(v)
}

fn greet() {
	println('greet')
}

fn double(x int) int {
	return x * 2
}

fn parse(s string) !int {
	if s == '' {
		return error('empty')
	}
	return s.int()
}

fn main() {
	call(|| greet())
	println(apply(|x| x * 2, 21))
	println(apply(|x| x * factor, 5))
	println(apply(|x| double(x), 4))
	println(apply(|n| parse(n.str()) or { panic(err) }, 7))
	println(apply(|n| apply(|m| m + factor, n), 1))
	println(Handler{}.cb(1))
	println([1, 2, 3].map(|n| n * factor))
	println([1, 2, 3].filter(|n| n > 1))
	// the implicit `it` of an array DSL call is not a capture
	println(apply(|n| [1, 2, 3].filter(it > n).len, 1))
	println(apply(|n| [1, 2, 3]!.filter(it > n).len, 2))
	println(apply(|n| Ints([1, 2, 3]).any(it > n).str().len, 3))
	println(lens(|a| a.filter(it > 1).len, [1, 2, 3]))
	mut a := [3, 1, 2]
	a.sort(|p, q| p < q)
	println(a)
	a.sort_with_compare(|p, q| *q - *p)
	println(a)
	ch := chan int{cap: 1}
	ch <- 6
	select {
		got := <-ch {
			// the received value is passed in, not captured
			println(apply(|x| x + factor, got))
		}
	}
}
