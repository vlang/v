module main

import callbacks

interface IFoo {
	name string
}

struct Foo {
	name string
}

pub struct Model {}

pub fn (model Model) get_foo() IFoo {
	return Foo{
		name: 'you should see this'
	}
}

pub fn (mut model Model) run() {
	value := model.get_foo()
	println(value)
}

// Keep an unrelated interface box in the program. The fallback added in
// vlang/v#28728 only applies when both boxed-type maps are completely empty.
interface Noise {
	marker int
}

struct NoiseValue {
	marker int
}

fn noise_marker(value Noise) int {
	return value.marker
}

fn main() {
	assert noise_marker(NoiseValue{ marker: 7 }) == 7
	mut model := Model{}
	callback := callbacks.bind(mut model)
	// No direct model.run() or model.get_foo() call before the first event.
	for _ in 0 .. 3 {
		callback.invoke('run') or { panic(err) }
	}
}
