module types

import v.flat

fn test_ownership_observation_views_keep_parent_state_private() {
	$if ownership ?&& prealloc {
		mut a := flat.FlatAst.new()
		scalar_id := a.add_val(.bool_literal, 'false')
		mut tc := TypeChecker.new(&a)
		mut state := tc.ownership_state()
		state.borrowed_vars['source'] = [BorrowInfo{ borrower: 'holder.target', pos: scalar_id }]
		state.ownership_fn_return_param_descs['main.alias'] = [OwnershipReturnParamDescendant{
			param_idx: 1
			via:       ['main.origin']
		}]
		errors_before := tc.errors.clone()
		types_before := tc.expr_type_values.clone()
		set_before := tc.expr_type_set.clone()
		checking_before := tc.checking_nodes.clone()
		scope_before := tc.cur_scope.names.clone()
		arena := unsafe { prealloc_scope_begin() }
		mut isolated := tc.fork_storage_observation_view()
		mut child := isolated.fork_storage_observation_view()
		mut lookup := child.fork_type_parse_view(tc.cur_file, tc.cur_module)
		assert voidptr(isolated.ownership) != voidptr(state)
		assert voidptr(child.ownership) == voidptr(isolated.ownership)
		assert voidptr(lookup.ownership) == voidptr(isolated.ownership)
		assert voidptr(child.storage_query_probe) == voidptr(isolated.storage_query_probe)
		assert voidptr(lookup.storage_query_probe) == voidptr(isolated.storage_query_probe)
		// Borrow retained descriptors so writes exercise the cloned backing storage.
		mut loans := unsafe { lookup.ownership.borrowed_vars['source'] }
		mut via := unsafe { lookup.ownership.ownership_fn_return_param_descs['main.alias'][0].via }
		assert unsafe { loans.data != state.borrowed_vars['source'].data }
		assert unsafe { via.data != state.ownership_fn_return_param_descs['main.alias'][0].via.data }
		loans[0] = BorrowInfo{ borrower: 'changed', pos: scalar_id }
		via[0] = 'main.changed'
		assert isolated.ownership.borrowed_vars['source'][0].borrower == 'changed'
		assert child.ownership.ownership_fn_return_param_descs['main.alias'][0].via == ['main.changed']
		assert state.borrowed_vars['source'][0].borrower == 'holder.target'
		assert state.ownership_fn_return_param_descs['main.alias'][0].via == ['main.origin']
		isolated.storage_query_probe.value_observations = storage_query_probe_max_observations - 1
		assert isolated.returned_receiver_local_storage_in_value(scalar_id, []flat.NodeId{}, map[string]flat.NodeId{}) == none
		assert !isolated.storage_query_probe.uncertain
		assert child.returned_receiver_local_storage_in_value(scalar_id, []flat.NodeId{}, map[string]flat.NodeId{}) == none
		assert lookup.storage_query_probe.uncertain
		assert !isolated.storage_query_probe.recheck_requested
		lookup.check_node(scalar_id)
		assert isolated.storage_query_probe.recheck_requested
		assert tc.storage_query_probe == unsafe { nil }
		assert tc.errors == errors_before
		assert tc.expr_type_values == types_before && tc.expr_type_set == set_before
		assert tc.checking_nodes == checking_before
		assert tc.cur_scope.names == scope_before
		unsafe { prealloc_scope_end(arena) }
		assert state.borrowed_vars['source'][0].borrower == 'holder.target'
		assert state.ownership_fn_return_param_descs['main.alias'][0].via == ['main.origin']
	}
}

fn test_ownership_results_survive_batch_arena_release() {
	$if ownership ?&& prealloc {
		a := flat.FlatAst.new()
		mut tc := TypeChecker.new(&a)
		tc.ownership_state()
		tc.enable_scoped_parallel_workers()
		assert tc.scoped_parallel_workers_enabled()
		scope := unsafe { prealloc_scope_begin() }
		mut worker := TypeChecker.new(&a)
		mut state := worker.ownership_state()
		state.ownership_fns['owned_fn'.clone()] = true
		state.owned_globals['global'.clone()] = 'string'.clone()
		state.ownership_fn_return_descs['return_desc'.clone()] = [OwnershipReturnDescendant{
			slot_idx:  1
			suffix:    '.field'.clone()
			type_name: 'string'.clone()
		}]
		state.ownership_fn_return_param_descs['param_desc'.clone()] = [OwnershipReturnParamDescendant{
			param_idx:     0
			slot_idx:      1
			source_suffix: '.source'.clone()
			target_suffix: '.target'.clone()
			via:           ['callee'.clone()]
		}]
		state.ownership_fn_param_descs['param'.clone()] = [OwnershipParamDescendant{
			param_idx: 0
			suffix:    '.field'.clone()
			type_name: 'string'.clone()
		}]
		state.ownership_fn_literal_ret_types['literal'.clone()] = Type(FnType{
			params:      [Type(Struct{ name: 'ScopedItem'.clone() })]
			return_type: Type(string_)
		})
		state.drop_at_fn_exit['drop_fn'.clone()] = [OwnershipDropEntry{
			name:      'local'.clone()
			type_name: 'ScopedItem'.clone()
		}]
		unsafe { prealloc_scope_leave(scope) }
		tc.ownership_merge_parallel_check_worker(&worker)
		dst := tc.ownership
		for key, _ in dst.ownership_fns {
			assert !unsafe { prealloc_scope_owns(scope, key.str) }
		}
		assert !unsafe { prealloc_scope_owns(scope, dst.owned_globals['global'].str) }
		assert !unsafe { prealloc_scope_owns(scope, dst.ownership_fn_return_descs['return_desc'][0].suffix.str) }
		assert !unsafe { prealloc_scope_owns(scope, dst.ownership_fn_return_param_descs['param_desc'][0].via[0].str) }
		assert !unsafe { prealloc_scope_owns(scope, dst.ownership_fn_param_descs['param'][0].type_name.str) }
		assert !unsafe { prealloc_scope_owns(scope, dst.drop_at_fn_exit['drop_fn'][0].name.str) }
		assert !unsafe { prealloc_scope_owns(scope, dst.drop_at_fn_exit['drop_fn'].data) }
		assert !unsafe { prealloc_scope_owns(scope, dst.ownership_fn_return_param_descs['param_desc'][0].via.data) }
		literal_type := dst.ownership_fn_literal_ret_types['literal']
		assert literal_type is FnType
		if literal_type is FnType {
			assert !unsafe { prealloc_scope_owns(scope, literal_type.params.data) }
			param_type := literal_type.params[0]
			assert param_type is Struct
			if param_type is Struct {
				assert !unsafe { prealloc_scope_owns(scope, param_type.name.str) }
			}
		}
		unsafe { prealloc_scope_free_after(scope) }
		assert dst.ownership_fns['owned_fn']
		assert dst.owned_globals['global'] == 'string'
		assert dst.ownership_fn_return_descs['return_desc'][0].suffix == '.field'
		assert dst.ownership_fn_return_param_descs['param_desc'][0].source_suffix == '.source'
		assert dst.ownership_fn_return_param_descs['param_desc'][0].via == ['callee']
		assert dst.ownership_fn_param_descs['param'][0].type_name == 'string'
		assert dst.ownership_fn_literal_ret_types['literal'].name() == 'fn(ScopedItem) string'
		assert dst.drop_at_fn_exit['drop_fn'][0].name == 'local'
	}
}
