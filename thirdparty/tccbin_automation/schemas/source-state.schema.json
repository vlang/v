{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-state.schema.json",
  "$defs": {
    "operation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation_id",
        "transition",
        "previous_generation",
        "resulting_generation",
        "previous_state_digest",
        "resulting_state_digest",
        "evidence_path",
        "evidence_digest",
        "previous_chain_digest",
        "resulting_chain_digest"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "operation_id": {"$ref": "common.schema.json#/$defs/sha256"},
        "transition": {"type": "string", "minLength": 1, "maxLength": 128},
        "previous_generation": {"$ref": "common.schema.json#/$defs/generation"},
        "resulting_generation": {"type": "integer", "minimum": 1},
        "previous_state_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "resulting_state_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "evidence_path": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^evidence/[0-9]{4}/[0-9]{2}/[1-9][0-9]*/[1-9][0-9]*/[A-Za-z0-9._\\-]+/[0-9a-f]{64}/[0-9]+-[A-Za-z0-9._\\-]+$"
            },
            {"pattern": ".*-[0-9a-f]{64}\\.json$"},
            {"not": {"pattern": ".*/[0-9]+--[0-9a-f]{64}\\.json$"}}
          ],
          "maxLength": 512
        },
        "evidence_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "previous_chain_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "resulting_chain_digest": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "operation_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_count", "anchor_digest", "entries"],
      "properties": {
        "start_count": {"type": "integer", "minimum": 0},
        "anchor_digest": {"$ref": "common.schema.json#/$defs/sha256"},
        "entries": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/operation_entry"}
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "source_id",
    "canonical_url",
    "ref",
    "status",
    "resolved_sha",
    "source_fingerprint",
    "last_attempt_at",
    "mode",
    "originating_run_id",
    "waiting_consumers",
    "operation_count",
    "operation_chain_digest",
    "operation_window"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "generation": {"$ref": "common.schema.json#/$defs/generation"},
    "source_id": {"type": "string", "enum": ["tinycc-mob", "bdwgc-master", "libatomic_ops-master"]},
    "canonical_url": {"type": "string", "pattern": "^https://"},
    "ref": {"$ref": "common.schema.json#/$defs/branch"},
    "status": {
      "type": "string",
      "enum": ["resolved", "source_unreachable", "invalid_configuration", "integrity_failed"]
    },
    "resolved_sha": {"$ref": "common.schema.json#/$defs/nullable_sha40"},
    "source_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "last_attempt_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "mode": {"type": "string", "enum": ["monthly", "upstream-recovery-daily"]},
    "originating_run_id": {"$ref": "common.schema.json#/$defs/nullable_run_id"},
    "waiting_consumers": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/sha256"}
    },
    "operation_count": {"type": "integer", "minimum": 0},
    "operation_chain_digest": {"$ref": "common.schema.json#/$defs/sha256"},
    "operation_window": {"$ref": "#/$defs/operation_window"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "resolved"}}},
      "then": {},
      "else": {"properties": {"resolved_sha": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "source_unreachable"}}},
      "then": {
        "properties": {
          "mode": {"const": "upstream-recovery-daily"},
          "originating_run_id": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "upstream-recovery-daily"}}},
      "then": {
        "properties": {
          "status": {"enum": ["source_unreachable", "resolved"]},
          "originating_run_id": {"type": "integer", "minimum": 1}
        }
      }
    }
  ]
}
