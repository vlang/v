# ignore sub-level extensionless build outputs
*/**/*
!*/
!*.*

# ignore generated binaries and object files
*.exe
*.o
*.so
.*.c
*.tmp.c
*.obj
*.exp
*.ilk
*.pdb
*.dll
*.lib
*.bak
*.dylib
a.out
.noprefix.vrepl_temp

# ignore v build files
# *.exe is already ignored above
/v
/v2
/vc
/v.c
/v.*.c
/v.c.out
/v1_fallback
/v_old
/vdbg
/vold
/vnew
/vprod
/vprod_gcc
/vprod_clang
.vrepl_temp.v
fns.txt
.noprefix.vrepl_temp.v

# Prefix local scratch/repro files with tmp. when they should stay untracked.
tmp.*

# ignore temp and cache directories
temp/
tmp/
cache/
.cache/

# unignore special files without extension
!.github/PULL_REQUEST_TEMPLATE
!.editorconfig
!.gitattributes
!.gitignore
!BSDmakefile
!Dockerfile
!Dockerfile.alpine
!Dockerfile.cross
!LICENSE
!Makefile
!GNUmakefile

# ignore editor files
.project/
.classpath/
.c9/
.vs/
*.launch
.settings/
*.sublime-workspace
.vscode/
*.code-workspace
*~
~*
.sesskey
*.db
*.swp
*.swo
*.swn
.env

# ignore debugger files
cachegrind.out.*
.gdb_history
*.dSYM
*.def
vgcore.*

# ignore system files
.DS_Store
._*
thumbs.db
/.symlink
/.bin

_docs

# ignore vs databases
*.suo
*.VC.db
*.rsp

# ignore cmd/tools/.disable_autorecompilation, which some package managers use.
cmd/tools/.disable_autorecompilation

test.bin

# ignore codespace env
.venv/
.direnv/
shell.nix
default.nix
flake.nix
.envrc

# generated by thirdparty/stdatomic/nix/cpp/gen.v
thirdparty/stdatomic/nix/cpp/*.h

# ignore thirdparty libs that are distributed separately
thirdparty/iossim/
thirdparty/iossim
thirdparty/tcc/
thirdparty/tcc
thirdparty/legacy/
thirdparty/legacy
thirdparty/stdatomic/nix/*.o
thirdparty/stdatomic/nix/*.a

# Ignore auto-generated amalgamated file
vlib/v/gen/c/cheaders.v

# ignore symlink to v created via `v symlink`
/usr/local/bin/v

# ignore files created by V language server
.vls/
